          "name": "Nasrin Mostafavi Pak",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:karlsruhe-institute-of-technology-kaiserstra-e-12-76131-karlsruhe-germ",
            "name": "Karlsruhe Institute of Technology, Kaiserstraße 12, 76131 Karlsruhe, Germany"
          },
          "agu:sequence": 1
