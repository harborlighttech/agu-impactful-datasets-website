        }
      ],
      "name": "United States Groundwater Well Database (USGWD)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0123",
      "agu:stableKey": "title:united states groundwater well database (usgwd)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "Groundwater wells are critical infrastructure that enable the monitoring, extraction, and use of groundwater, which has important implications for the environment, water security, and economic development. Despite the importance of wells, a unified database collecting and standardizing information on the characteristics and locations of these wells across the United States has been lacking. To bridge this gap, a comprehensive database of groundwater well records was created using data collected from state and federal agencies. This database is called the United States Groundwater Well Database (USGWD). Presented in both tabular form and as vector points, the USGWD comprises over 14.2 million well records with attributes such as well purpose, location, depth, and capacity for wells constructed as far back as 1763 to 2023. Rigorous cross-verification steps have been applied to ensure the accuracy of the data. The USGWD stands as a valuable tool for improving our understanding of how groundwater is accessed and managed across various regions and sectors within the United States.…",
      "url": "https://www.hydroshare.org/resource/8b02895f02c14dd1a749bcc5584a5c55/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:chung-yi-lin",
          "name": "Chung-Yi Lin"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:alexandra-miller",
          "name": "Alexandra Miller"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:musab-waqar",
          "name": "Musab Waqar"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:landon-t-marston",
          "name": "Landon T. Marston"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:cuahsi",
          "name": "CUAHSI"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:hydroshare",
        "name": "Hydroshare"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Lin, C.-Y., Miller, A., Waqar, M., & Marston, L. T. (2024). A database of groundwater wells in the United States. Scientific Data, 11(1), 335. https://doi.org/10.1038/s41597-024-03186-3"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Although published in mid-2024, the United States Groundwater Well Database (USGWD) has already gained substantial traction within the hydrologic and environmental science community. The dataset has…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-9116-1691",
          "name": "Landon Marston",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:virginia-tech-925-prices-fork-road-blacksburg-va-24060",
            "name": "Virginia Tech, 925 Prices Fork Road, Blacksburg, VA 24060"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The dataset was nominated because the United States Groundwater Well Database (USGWD) is the first openly available, standardized, nation-wide compilation of groundwater well locations, purposes, and attributes for the U.S., assembled from state and federal sources, harmonized to a common schema, and delivered as both tabular (CSV) and geospatial (SHP) products with rigorous QA/QC flags. Spanning wells constructed from the 18th century through 2023 and totaling ~14.2 million records, it transforms fragmented state records into a coherent national resource that enables comparable analyses across jurisdictions and disciplines. Without USGWD, many cross-state assessments of groundwater access, monitoring coverage, and infrastructure trends would remain infeasible or irreproducible. People — education, training, disaster response and prediction USGWD lowers barriers for educators, students,…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0124",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0124",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0124"
        },
        {
          "@type": "PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.7914/SN/TA"
        }
      ],
      "name": "USArray Transportable Array",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:surface"
      },
      "agu:datasetId": "agu-0124",
      "agu:stableKey": "doi:10.7914/sn/ta|usarray transportable array",
      "agu:nominatorCount": 1,
      "agu:citationCount": 3,
      "agu:reuseCount": 4,
      "description": "The USArray Transportable Array was a revolutionary geoscience project that fundamentally changed our understanding of the North American continent's structure and evolution. Its main impact was creating the first high-resolution, continent-scale 3D image of the Earth's crust and upper mantle. For over a decade, a dense network of 400 high-quality seismometers was systematically moved across the United States, collecting a massive, uniform dataset of seismic waves from earthquakes around the world. This allowed scientists to create detailed 3D maps of the Earth's interior, revealing geological structures with unprecedented clarity. The USArray project created a massive, open-access dataset of unparalleled quality and scale. This \"firehose of data\" spurred a wave of innovation in seismology, allowing researchers worldwide to develop and test new analytical methods. It set a new standard for \"big data\" in the Earth sciences and fostered a more collaborative research environment. The dense grid of seismometers allowed for a much more detailed analysis of how seismic waves travel. This…",
      "url": "https://doi.org/10.7914/SN/TA",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:iris-data-management-center",
          "name": "IRIS Data Management Center"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:earthscope-data-services",
          "name": "EarthScope Data Services"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:earthscope-data-services",
        "name": "EarthScope Data Services"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "https://www.fdsn.org/networks/detail/TA/"
        },
        {
          "@type": "CreativeWork",
          "text": "https://doi.org/10.1175/BAMS-D-14-00204.1"
        },
        {
          "@type": "CreativeWork",
          "text": "https://www.earthscope-program-2003-2018.org/articles/continental_evolution_TA.html"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "https://www.iris.edu/hq/inclass/data-product/usarray_ground_motion_visualizations"
        },
        {
          "@type": "CreativeWork",
          "text": "https://www.earthscope-program-2003-2018.org/articles/USArray_infrasound_data_products.html"
        },
        {
          "@type": "CreativeWork",
          "text": "https://ds.iris.edu/ds/products/ancc-ciei/"
        },
        {
          "@type": "CreativeWork",
          "text": "https://www.earthscope.org/news/the-usarray-project-was-a-think-big-moment-for-seismology/"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-4981-8340",
          "name": "Rob Casey",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:earthscope-consortium",
            "name": "EarthScope Consortium"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The USArray Transportable Array provided benefits both to society and our understanding of the North American continental structure and dynamics. The USArray project was a goldmine for science education. Its high-quality, open-access dataset allowed students at all levels, from K-12 to university, to work with real-world scientific data, a rare opportunity in Earth science. The 3D tomographic models generated from the dense array of seismometers across the continent are powerful and intuitive teaching tools. They make abstract geological concepts, like subducting plates and mantle plumes, visible and understandable to a broad audience. The project significantly improved our ability to prepare for and respond to seismic events. By providing a much clearer picture of the Earth's crust, including previously unknown faults and structural weaknesses, USArray data helps create more accurate…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0125",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0125",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0125"
        }
      ],
      "name": "USGS Spectral Library",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:materials"
      },
      "agu:datasetId": "agu-0125",
      "agu:stableKey": "title:usgs spectral library",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "Founded by Dr. Roger Clark in the 1980s, researchers at the USGS Spectroscopy Laboratory have measured the spectral reflectance of thousands of materials in the lab and compiled them in the USGS Spectral Library. The spectral library was assembled to facilitate laboratory and field spectroscopy and remote sensing for identifying and mapping minerals, vegetation, and manmade materials. For many of the samples, wavelength coverage spans the ultraviolet, visible, near-infrared, mid-infrared, and far-infrared regions (0.2 to 200 microns). A wide range of materials are included in the library: minerals, soils, coatings on rocks, liquids and frozen volatiles, organic compounds, manmade materials, and vegetation and other biologic materials. Detailed sample descriptions are provided with the spectra, including the results of X-ray Diffraction, Electron Probe Micro-Analysis, and other analytical methods. The library is presently managed by Dr. Ray Kokaly.",
      "url": "https://www.usgs.gov/labs/spectroscopy-lab/usgs-spectral-library",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:roger-clark-et-al-usgs-ray-kokaly-usgs-gregg-swayze-usgs-et-al",
          "name": "Roger Clark et al (USGS), Ray Kokaly (USGS), Gregg Swayze (USGS), et al."
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:ray-kokaly-usgs-et-al",
          "name": "Ray Kokaly (USGS) et al."
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:https-www-sciencebase-gov-catalog-item-5807a2a2e4b0841e59e3a18d",
        "name": "https://www.sciencebase.gov/catalog/item/5807a2a2e4b0841e59e3a18d"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-2745-3240",
          "name": "Bethany Ehlmann",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-colorado-boulder-3665-discovery-drive-boulder-co-80303",
            "name": "University of Colorado Boulder, 3665 Discovery Drive, Boulder, CO 80303"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "There are two visible/shortwave infrared databases of earth and planetary materials. Nearly every solar system discovery is based on the prescient work of Roger Clark at USGS and, separately, Carle Pieters at Brown University to curate high quality collections of measurements of what geological materials look like in the visible and near infrared. These are repositories openly available to any investigator to download spectra and compare to what they observe with telescopes, spacecraft, or field and lab studies on Earth. Clay minerals on Mars, sodium carbonates on Ceres, pure sulfur on Io, serpentines on asteroids all relied on these databases. Remote sensing on Earth too uses these for albedo properties. Each has strengths: USGS has separate associated files that contain an independent characterization of composition, including impurities while RELAB lets any research submit a…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0126",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0126",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0126"
        }
      ],
      "name": "Vegetation Photosynthetic Phenology Metrics in Northern Terrestrial Ecosystems",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0126",
      "agu:stableKey": "title:vegetation photosynthetic phenology metrics in northern terrestrial ecosystems",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "Vegetation phenology can profoundly modulate the climate-biosphere interactions and thus plays a crucial role in regulating the terrestrial carbon cycle and the climate. However, most previous phenology studies rely on traditional vegetation indices, which are inadequate to characterize the seasonal activity of photosynthesis. An annual vegetation photosynthetic phenology dataset was generated with a spatial resolution of 0.05 degrees from 2001 to 2020, using the latest gross primary productivity product based on solar-induced chlorophyll fluorescence (GOSIF-GPP). Smoothing splines were combined with multiple change-point detection to retrieve the phenology metrics: start of the growing season (SOS), end of the growing season (EOS), and length of growing season (LOS) for terrestrial ecosystems above 30° N latitude (Northern Biomes). The phenology product can be used to validate and develop phenology or carbon cycle models and monitor the climate change impacts on terrestrial ecosystems. (https://www.nature.com/articles/s41597-023-02224-w)",
      "url": "https://figshare.com/articles/dataset/Vegetation_photosynthetic_phenology_metrics_in_northern_terrestrial_ecosystems_a_dataset_derived_from_a_gross_primary_productivity_product_based_on_solar-induced_chlorophyll_fluorescence/17195009",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:jing-fang",
          "name": "Jing Fang"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:wuhan-botanical-garden",
          "name": "Wuhan Botanical Garden"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:figshare",
        "name": "Figshare"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Fang, J., Li, X., Xiao, J., Yan, X., Li, B., & Liu, F. (2023). Vegetation photosynthetic phenology dataset in northern terrestrial ecosystems. Scientific Data, 10(1), 300. https://doi.org/10.1038/s41597-023-02224-w"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Fang, J. (2022). Find phenology dates of GPP [Computer software]. Zenodo. https://doi.org/10.5281/ZENODO.7266229"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-4955-1212",
          "name": "Jing Fang",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:chinese-academy-of-sciences-beijing-100864-china",
            "name": "Chinese Academy of Sciences, Beijing, 100864, China"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset was nominated because it represents a critical advance in understanding and monitoring how ecosystems respond to ongoing climate variability and change. Unlike traditional greenness-based metrics that primarily reflect structural shifts in vegetation canopy, this dataset is built on photosynthetic activity derived from solar-induced chlorophyll fluorescence (SIF)–based gross primary productivity (GPP). This functional perspective allows researchers and decision-makers to more directly track when and where plants are actually fixing carbon. This dataset provides a transformative perspective on how ecosystems respond to climate change by capturing photosynthetic phenology rather than relying solely on greenness indices. Derived from GOSIF-GPP, it offers a continuous, high-resolution record (2001–2020) of the start, end, and length of growing seasons across northern…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0127",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0127",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0127"
        }
      ],
      "name": "Water Quality Portal",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0127",
      "agu:stableKey": "title:water quality portal",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 1,
      "description": "The Water Quality Portal (https://www.waterqualitydata.us/) is the largest water quality data warehouse in the United States containing over 400 million water quality records from over one million locations nationally sourced from over 1,000 water quality data providers, including every state, territory, and over 100 tribes and Nations. The information served by the Water Quality Portal is used to make Clean Water Act decisions such as “Can I swim in the water or eat the fish?”, helps inform scientific studies and advancements in academia, and informs State and Federal actions such as compliance monitoring and targeting and the establishment of permits and water quality standards. The Water Quality Portal was launched in 2012 after a MOU was signed between the United States Environmental Protection Agency (USEPA) and United States Geological Survey (USGS) in 2008, the realization of a vision of unified data management to better support water-quality decision making nationally by delivering data in a unified format on one platform. The Water Quality Portal is currently funded by both…",
      "url": "https://www.waterqualitydata.us/beta/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:us-geological-survey-us-enviornmental-protection-agency",
          "name": "US Geological Survey, US Enviornmental Protection Agency"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:wqp-usgs-gov",
          "name": "wqp@usgs.gov"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:hosted-by-usgs-aws-hosted",
        "name": "Hosted by USGS (AWS hosted)"
      },
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "https://www.waterqualitydata.us/beta/publications/"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-3207-7267",
          "name": "Candice Hopkins",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:us-geological-survey-12201-sunrise-valley-drive-reston-va-20192",
            "name": "US Geological Survey, 12201 Sunrise Valley Drive, Reston, VA 20192"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The Water Quality Portal brings together data from many agencies and exposes this data to the public in a common and consumable format. Without the Water Quality Portal, many of these data would not be exposed to the public or would be under too much of an access burden for the public to retrieve the data. The complexity of water quality data that are not standardized make them almost insurmountably difficult to aggregate and analyze. However, publishing data in a standardized and FAIR manner help to make these data accessible to the public. This dataset also allows smaller groups, such as citizen science groups, to publish their data in a way that makes their data findable and easy to incorporate into large-scale studies and syntheses."
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0128",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0128",
