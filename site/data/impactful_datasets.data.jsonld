      },
      "agu:datasetId": "agu-0024",
      "agu:stableKey": "title:calcofi fish larvae at 66 standard stations, 1966 - ongoing",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 1,
      "description": "The CalCOFI larval fish dataset is one of the world’s longest and most comprehensive biological ocean time series, extending from the 1940s to the present off the coast of California. It originated in response to the devastating collapse of the Pacific sardine fishery once among the largest in the world to understand how oceanographic conditions influenced fish populations and to prevent similar collapses in the future. The dataset provides continuous, standardized observations of 100s of ichthyoplankton (fish larvae) across the California Current Ecosystem (CCE), alongside concurrent measurements of physical, chemical, and biological ocean properties. This uniquely integrated dataset enables researchers to study ecosystem structure, fisheries recruitment, climate variability, and long-term environmental change. The larval fish time series has become a cornerstone for ecological and fisheries research, forming the empirical basis for management of key California and federal fisheries.",
      "url": "https://coastwatch.pfeg.noaa.gov/erddap/tabledap/erdCalCOFIlrvcnt.html",
      "sameAs": [
        "https://portal.edirepository.org/nis/metadataviewer?packageid=edi.109.2",
        "https://obis.org/dataset/0e223f55-c826-4513-ae9a-b04cbf2e189c"
      ],
      "creator": [
        {
          "@type": "Person",
