      ],
      "name": "NCEP/CPC L3 Half Hourly 4km Global (60S - 60N) Merged IR",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0089",
      "agu:stableKey": "doi:10.5067/p4hzb9n27eku|ncep/cpc l3 half hourly 4km global (60s - 60n) merged ir",
      "agu:nominatorCount": 1,
      "agu:citationCount": 2,
      "agu:reuseCount": 1,
      "description": "This gridded global merged multi-satellite geostationary infrared (IR) brightness temperature product (1998-present) originates from the NOAA Climate Prediction Center (CPC), the National Centers for Environmental Prediction (NCEP), and the National Weather Service (NWS) and are hosted by NASA’s Goddard Earth Sciences Data and Information Services Center (GES DISC). The 4-km datasets contain IR brightness temperature data (equivalent blackbody temps), merged from the European, Japanese, and U.S. geostationary satellites that have been active over the product’s period of record (METEOSAT-5/7/8/9/10, GMS-5/MTSat-1R/2/Himawari-8, and GOES-8/9/10/11/12/13/14/15/16), and gridded to 4-km every half hour on the latitude band 60°S-60°N. The NASA GES DISC converts the original binary data into a self-documenting, CF-compliant, netCDF-4 format, which allows a broad range of applications to access the data directly, without the need to cope with the original binary data format. The creation of the original data at NOAA/NCEP is supported by funding from the NOAA Office of Global Programs for…",
      "url": "https://doi.org/10.5067/P4HZB9N27EKU",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:pingping-xie",
          "name": "Pingping Xie"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:mahabal-hegde-ges-disc-manager-or-ges-disc-help-desk-gsfc-dl-help-disc",
          "name": "Mahabal Hegde (GES DISC Manager), or GES DISC Help Desk (gsfc-dl-help-disc@mail.nasa.gov)"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:nasa-goddard-earth-sciences-ges-data-and-information-services-center-d",
        "name": "NASA Goddard Earth Sciences (GES) Data and Information Services Center (DISC)"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Janowiak, J. E., Joyce, R. J., & Yarosh, Y. (2001). A real–time global half–hourly pixel–resolution infrared dataset and its applications. Bulletin of the American Meteorological Society, 82(2), 205–217. https://doi.org/10.1175/1520-0477(2001)082<0205:ARTGHH>2.3.CO;2"
        },
        {
          "@type": "CreativeWork",
          "text": "Liu, Z., Ostrenga, D., & Leptoukh, G. (2011). Online visualization and analysis of global half-hourly infrared satellite data. Bulletin of the American Meteorological Society, 92(4), 429–432. https://doi.org/10.1175/2010BAMS2976.1"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Eldrett, J.S., Bergman, S.C. and Minisini, D., 2024. Statistical approaches for improved definition of carbon isotope excursions. Earth-Science Reviews, 255, p.104851."
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-8150-7556",
          "name": "Zhong Liu",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:nasa-ges-disc-gmu-nasa-goddard-space-flight-center-greenbelt-md-20771",
            "name": "NASA GES DISC (GMU), NASA Goddard Space Flight Center, Greenbelt, MD 20771"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "Infrared (IR) data plays an important role in weather forecasting and environmental monitoring. Geostationary IR data provide continuous, real-time data for tracking weather patterns, such as hurricanes, fronts, and atmospheric rivers, for short-term forecasting. Some examples are found in Janowiak et al. (2001) and Liu et al. (2011). IR data is used for monitoring cloud cover, ocean currents, volcanic ash, and vegetation, helping scientists study climate change and environmental phenomena. IR data is widely used in disaster management, such as tracking wildfires and providing crucial information for emergency response efforts. Historical IR data is equally important for many activities, such as case studies, algorithm development, and climate data records. IR data is used to derive physical parameters. IR data is an important input for deriving IR-based and/or multi-sensor,…"
        }
      ]
    },
