        {
          "@type": "PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.1002/gdj3.174"
        }
      ],
      "name": "Global Extreme Sea Level Analysis (GESLA)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0053",
      "agu:stableKey": "doi:10.1002/gdj3.174|global extreme sea level analysis (gesla)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 2,
      "description": "The Global Extreme Sea Level Analysis (GESLA) project was initiated in 2009 through a collaborative effort to better understand changes in the frequency and magnitude of extreme sea levels. Its original goal was to compile as many high-frequency (hourly or more frequent) sea-level records as possible into a unified format with consistent quality control, enabling researchers to easily, quickly and freely access data and analyze tides, storm surges, and other extreme sea-level processes on a global scale. Since its inception, several versions of the dataset have been released, culminating in GESLA-4 (July 2025), which provides the most extensive temporal and spatial coverage to date. GESLA-4 includes 127,623 station-years of data from 6,474 records contributed by over 40 data providers worldwide. Each record in the dataset offers sea-level measurements with at least hourly resolution, accompanied by detailed metadata describing the contributor, location, geographical classification (coastal, lake, or river), datum, and record length. Additionally, each individual observation includes…",
      "url": "https://doi.org/10.1002/gdj3.174",
      "sameAs": [
        "https://gesla.org"
      ],
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:ivan-haigh",
          "name": "Ivan Haigh"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:marta-marcos",
          "name": "Marta Marcos"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:stefan-talke",
          "name": "Stefan Talke"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:phil-woodworth",
          "name": "Phil Woodworth"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:ivan-haigh-and-elizabeth-bradshaw",
          "name": "Ivan Haigh and Elizabeth Bradshaw."
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:british-oceanographic-data-centre-bodc-ad-website-https-gesla-org",
        "name": "British Oceanographic Data Centre (BODC) ad website (https://gesla.org)"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Haigh, I. D., Marcos, M., Talke, S. A., Woodworth, P. L., Hunter, J. R., Hague, B. S., Arns, A., Bradshaw, E., & Thompson, P. (2023). gesla version 3: A major update to the global higher‐frequency sea‐level dataset. Geoscience Data Journal, 10(3), 293–314. https://doi.org/10.1002/gdj3.174"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Based on Google Scholar information Haigh et al. (2023) has been cited 142 times and"
        },
        {
          "@type": "CreativeWork",
          "text": "Woodworth et al. (2017), 207 times. GESLA forms the basis for virtually all global extreme sea level assessments; it has been used in the three most recent Intergovernmental Panel on Climate Change…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-7802-2662",
          "name": "Ariadna Martin",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:department-of-civil-environmental-and-construction-engineering-univers",
            "name": "Department of Civil, Environmental and Construction Engineering, University of Central Florida, Orlando, FL 32816, USA"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "Sea-level measurements are fundamental for understanding and managing the interactions between the ocean and coastal environments. Accurate, high-resolution sea-level data underpin a wide range of scientific, operational, and societal applications. From assessing coastal flood risk and informing the design of defenses to studying erosion and protecting ecosystems such as coral reefs, mangroves, and wetlands, these observations are critical for decision-making from local to global scales. For decades, the Permanent Service for Mean Sea Level (PSMSL) has provided invaluable long-term records of monthly and annual means, crucial for tracking climate-driven sea-level rise. However, many impactful coastal processes, particularly extreme sea-level events, occur over much shorter timescales of hours to days. Capturing these dynamics requires high-frequency observations that mean sea-level…"
        }
      ]
    },
