      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-0177-7770",
          "name": "Erin Satterthwaite",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:scripps-institution-of-oceanography-ucsd-8622-kennel-way-la-jolla-ca-9",
            "name": "Scripps Institution of Oceanography, UCSD, 8622 Kennel Way, La Jolla, CA 92037"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "CalCOFI Bottle Data was nominated because it represents one of the most enduring and influential ocean observing datasets in the world. Established in 1949 in response to the collapse of the Pacific sardine fishery, CalCOFI has sustained, quality-controlled record of ocean temperature, salinity, oxygen, nutrients, and chlorophyll from discrete seawater samples provides unparalleled insight into how the California Current Ecosystem has changed over time. Without this 76 year record, the scientific community would lack a coherent picture of ocean ecosystem variability in one of the world’s most productive and economically significant coastal regions. It can be regarded as the scientific community’s “eyes and ears” beneath the surface and continues to shape our understanding of the ocean and our collective capacity to sustain it. Planet -- CalCOFI’s Bottle Data has served as the foundation…"
        }
      ]
