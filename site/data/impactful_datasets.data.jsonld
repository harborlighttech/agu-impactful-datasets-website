      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "OCO-2 provides high-precision measurements of atmospheric CO₂ concentrations over regions where no ground-based observations exist. Since its launch in 2014, it has become one of the longest-running satellite records of global CO₂, offering a decade of continuous, high-resolution coverage. These data are critical for constraining global CO₂ emissions, validating national and regional emission inventories, and holding countries and sectors accountable for their greenhouse gas outputs. Without OCO-2, our understanding of spatial and temporal patterns in CO₂ emissions would be far less accurate, limiting the ability to develop effective climate mitigation strategies. Beyond CO₂, OCO-2’s Solar-Induced Fluorescence (SIF) product offers unprecedented insight into plant photosynthetic activity at a global scale. This near-real-time, worldwide coverage is nearly impossible to achieve with…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0098",
