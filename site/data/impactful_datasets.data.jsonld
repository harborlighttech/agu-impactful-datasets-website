      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-0844-9390",
          "name": "Justine Blanford",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-twente-drienerlolaan-5-7522-nb-enschede-the-netherlands",
            "name": "University of Twente, Drienerlolaan 5, 7522 NB Enschede, The Netherlands"
