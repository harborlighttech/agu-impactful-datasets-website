      "agu:datasetId": "agu-0021",
      "agu:stableKey": "doi:10.58024/agum46bd292f|australian thermochronology - 2002 and prior",
      "agu:nominatorCount": 1,
      "agu:citationCount": 3,
      "agu:reuseCount": 1,
      "description": "This dataset contains low-temperature thermochronology analyses derived primarily from Archaean to Palaeozoic igneous rocks and their metamorphic equivalents across the Australian continent from the 1970s to 2002. It includes detailed information on sample locations, lithologies, over 1,800 apatite fission track age determinations, mean confined track length measurements and thermal history models, as well as minor data from titanite and zircon fission track analyses. The collection additionally contains digitised thermal history paths which provide time-temperature predictions for reconstructed intervals and inverse model parameters for each modelled sample, allowing for evaluation of the thermal state of crustal rocks through time. Originally reported and discussed by Kohn et al. (2002) and Gleadow et al. (2002), these data provide key insights into the low-temperature tectono-thermal evolution of Australia’s upper crust over the past ~300 million years, including denudation rates across the continent and the influence of regional tectonic episodes. A subset of this collection…",
      "url": "https://doi.org/10.58024/agum46bd292f",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:barry-kohn-andrew-gleadow-roderick-brown-kerry-gallagher-paul-o-sulliv",
          "name": "Barry Kohn, Andrew Gleadow, Roderick Brown, Kerry Gallagher, Paul O'Sullivan, David Foster, Samuel Boone, Malcolm McMillan"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:auscope-geochemistry-network",
          "name": "AuScope Geochemistry Network"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:auscope-earthbank-platform",
        "name": "AuScope EarthBank Platform"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Gleadow, A. J. W., Kohn, B. P., Brown, R. W., O’Sullivan, P. B., & Raza, A. (2002). Fission track thermotectonic imaging of the Australian continent. Tectonophysics, 349(1–4), 5–21. https://doi.org/10.1016/S0040-1951(02)00043-4"
        },
        {
          "@type": "CreativeWork",
          "text": "Kohn, B. P., Gleadow, A. J. W., Brown, R. W., Gallagher, K., O’Sullivan, P. B., & Foster, D. A. (2002). Shaping the Australian crust over the last 300 million years: Insights from fission track thermotectonic imaging and denudation studies of key terranes. Australian Journal of Earth Sciences,…"
        },
        {
          "@type": "CreativeWork",
          "text": "Kohn, B. P., Gleadow, A. J. W., Brown, R. W., Gallagher, K., O’Sullivan, P. B., & Foster, D. A. (2020). Australian-wide apatite fission track data compilation [Text/tab-separated-values]. PANGAEA. https://doi.org/10.1594/PANGAEA.911861"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Dickson, A.J., Hilton, R.G., Prytulak, J., Minisini, D., Eldrett, J.S., Dellinger, M., Stow, M. and Wang, W., 2024. Rhenium isotopes record oxidative weathering intensity in sedimentary rocks.…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-3638-1864",
          "name": "Angus Nixon",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:the-university-of-adelaide-250-north-terrace-adelaide-sa-5005-australi",
            "name": "The University of Adelaide, 250 North Terrace, Adelaide SA 5005, Australia"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The Australian thermochronology dataset from 2002 and prior provides a valuable resource for assessing the low-temperature (~60–120 °C) history of Australia throughout the Palaeozoic–Cenozoic. This thermal window is key to understanding the behavior and evolution of rocks and minerals in the upper crust in response to broad tectonic and geodynamic forces, including structural reactivation, basin initiation and evolution, palaeoclimate, climate change, and the creation and preservation of mineral and energy resources. These signals are often not preserved in more widely available geochemical and isotopic tools, and thus this dataset helps to fill a key gap in our understanding of lithosphere evolution. In an Australian context, low-temperature data is vital for assessing the continental history following amalgamation and widespread orogenesis across the West Australian Craton, North…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0022",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0022",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0022"
        },
        {
          "@type": "PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.58024/agumcad7b7cb"
        }
      ],
      "name": "Australian Thermochronology - 2002 to 2022",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:interior"
      },
      "agu:datasetId": "agu-0022",
      "agu:stableKey": "doi:10.58024/agumcad7b7cb|australian thermochronology - 2002 to 2022",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "This compilation brings together apatite fission-track (AFT) and (U–Th)/He thermochronology data acquired between 2002 and 2022 from regions spanning Australia and Papua New Guinea, primarily from the University of Melbourne Thermochronology Laboratory. It integrates both published and previously unpublished results derived from diverse igneous, metamorphic, and sedimentary lithologies. The dataset includes detailed sample metadata and lithological descriptions of analysed materials, and a collection of over 1,300 fission-track ages and length distributions, 153 (U–Th)/He age determinations, and 91 digitised thermal history models. Collectively, these data provide an expanded perspective on the low-temperature thermal evolution of the Australasian crust, building upon and enhancing earlier continental-scale thermochronological frameworks.",
      "url": "https://doi.org/10.58024/agumcad7b7cb",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:samuel-boone-malcolm-mcmillan-angus-nixon-ling-chung-christian-seiler",
          "name": "Samuel Boone, Malcolm McMillan, Angus Nixon, Ling Chung, Christian Seiler, Stijn Glorie, Barry Kohn, Andrew Gleadow"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:auscope-geochemistry-network",
          "name": "AuScope Geochemistry Network"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:auscope-earthbank-platform",
        "name": "AuScope EarthBank Platform"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-3638-1864",
          "name": "Angus Nixon",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:the-university-of-adelaide-250-north-terrace-adelaide-sa-5005-australi",
            "name": "The University of Adelaide, 250 North Terrace, Adelaide SA 5005, Australia"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This compilation of Australasian thermochronology acquired between 2002 and 2022 is a valuable resource for assessing the low-temperature (~40–120 °C) history of Australia and Papua New Guinea throughout the last ~300 million years. These temperatures in the shallow crust are key to understanding the evolution of rocks and minerals in response to broad tectonic and geodynamic forces, including orogenesis, structural reactivation, crustal amalgamation, basin initiation and evolution, palaeoclimate, long-term climate change, and the creation and preservation of mineral and energy resources. These effects often occur at temperatures below the sensitivity of more widely available geochemical and isotopic methods, and require lower temperature chronometers such as the apatite fission track and (U-Th)/He systems to resolve these sub-metamorphic events. This collection provides expanded…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0023",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0023",
      "identifier": [
