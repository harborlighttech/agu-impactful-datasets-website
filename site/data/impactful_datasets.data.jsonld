      ],
      "name": "Integrated Multi-satellitE Retrievals for the Global Precipitation Measurement (GPM) mission (IMERG)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:atmos"
      },
      "agu:datasetId": "agu-0002",
      "agu:stableKey": "doi:10.5067/gpm/imerg/3b-hh-e/07|integrated multi-satellite retrievals for the global precipitation measurement (gpm) mission (imerg)",
      "agu:nominatorCount": 6,
      "agu:citationCount": 3,
      "agu:reuseCount": 5,
      "description": "See https://disc.gsfc.nasa.gov/datasets/GPM_3IMERGHH_07/summary?keywords=IMERG IMERG is NASA’s open-source observational global precipitation product. It is the unified U.S. GPM algorithm that provides precipitation products at half-hour 0.1°x0.1° globally for 1998-present. The estimates from the available precipitation-relevant satellite passive microwave (PMW) sensors are computed, intercalibrated, and merged. Merged geo-IR estimates are computed, intercalibrated to the PMW, and input to a Morphing-Kalman Filter along with the PMW. Motion vectors for the quasi-Lagrangian PMW morphing are computed from numerical reanalysis (Final) and numerical forecast (Early and Late) data fields. The IMERG system is run twice in near-real time: • \"Early\" multi-satellite product ~4 hr after observation (forward morphing only) and • \"Late\" multi-satellite product ~14 hr after observation (forward and backward morphing), and once after real time: • \"Final\", satellite-gauge product ~4 months after the observation month, (forward and backward morphing, monthly gauge analyses). Each new version of…",
      "url": "https://doi.org/10.5067/GPM/IMERG/3B-HH-E/07",
      "sameAs": [
        "https://doi.org/10.5067/GPM/IMERG/3B-HH-L/07",
        "https://doi.org/10.5067/GPM/IMERG/3B-HH/07",
        "https://doi.org/10.5067/GPM/IMERG/3B-MONTH/07"
      ],
