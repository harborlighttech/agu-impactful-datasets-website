      ],
      "name": "XA (1969-1977): Apollo Passive Seismic Experiments",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:space"
      },
      "agu:datasetId": "agu-0132",
      "agu:stableKey": "title:xa (1969-1977): apollo passive seismic experiments",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "This is a new archive of the Apollo Passive Seismic data. The archive contains timing information. For more details, please see: Nunn, C., Nakamura, Y., Kedar, S., & Panning, M. P. (2022). A new archive of apollo’s lunar seismic data. The Planetary Science Journal, 3(9), 219. https://doi.org/10.3847/PSJ/ac87af It is also recommended that the following Getting Started page be read: https://github.com/cerinunn/pdart/blob/master/getting_started.ipynb https://www.fdsn.org/networks/detail/XA_1969/",
      "url": "https://www.fdsn.org/networks/detail/XA_1969/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:nunn-c",
          "name": "Nunn, C."
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:international-federation-of-digital-seismograph-networks-fdsn",
        "name": "International Federation of Digital Seismograph Networks (FDSN)"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Nunn, C., Nakamura, Y., Kedar, S., & Panning, M. P. (2022). A new archive of apollo’s lunar seismic data. The Planetary Science Journal, 3(9), 219. https://doi.org/10.3847/PSJ/ac87af"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Onodera, K. (2024). New views of lunar seismicity brought by analysis of newly discovered moonquakes in apollo short‐period seismic data. Journal of Geophysical Research: Planets, 129(7),…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-5647-8001",
          "name": "Ceri Nunn",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:jet-propulsion-laboratory-california-institute-of-technology-4800-oak",
            "name": "Jet Propulsion Laboratory, California Institute of Technology, 4800 Oak Grove Drive, Pasadena, CA 91109, USA"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset has a long history. It was originally collected on the Moon during the Apollo missions, and sent directly to Earth, in real time. It was one of the first examples of a digital seismic network. It covers a network of seismic stations which were placed on the Moon by Apollo astronauts, and operated from 1969 until the stations were turned off in 1977. The nominator is recommending a version which was reprocessed for modern seismologists, and rearchived in 2022. The dataset was used to discover 22,0000 previously unidentified moonquakes. The paper, which was published in AGU’s JGR Planets, reanalyzed the seismic data using the new archive (Onodera, 2024). Headlines included “New Moonquakes from Old Data” (Montési, 2024), “Moonquakes are much more common than thought, Apollo data suggest” (Grossman, 2024), “Number of known moonquakes tripled with discovery in Apollo archive”…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0133",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0133",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0133"
        }
      ],
      "name": "Yax Chen diatom analysis (Supplementary Information)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0133",
      "agu:stableKey": "title:yax chen diatom analysis (supplementary information)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 0,
      "description": "This dataset comprises an analysis of the microalgae known as diatoms from the Yax Chen aquifer cave system in the Yucatan Peninsula, Mexico, spanning the time period May 2012–2017 when several tropical cyclones affected the region. Yax Chen is part of the peninsula’s extensive anchialine aquifer, which is the largest globally: The aquifer consists of a thin freshwater lens or meteoric water mass that is stratified atop a denser marine water mass that flows inward from the coast and is the primary source of freshwater across the peninsula, although it has been found to be vulnerable to environmental change. Diatoms are regarded as excellent bioindicators for modelling environmental change and water quality due to their high sensitivity, and have also been stated to be the most representative group of the phytobenthos. The diatoms used for this dataset were collected from four sediment trap stations positioned along the length of Yax Chen as part of a more extensive ongoing environmental monitoring project. The sediment trap samples were collected from the sampling stations…",
      "url": "http://hdl.handle.net/11375/32542",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:katelyn-mountjoy-eduard-g-reinhardt",
          "name": "Katelyn Mountjoy, Eduard G. Reinhardt"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:macsphere",
        "name": "MacSphere"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "The gathering storm? An examination of diatoms as paleoenvironmental indicators of tropical cyclone activity that may have precipitated the Classic Maya Decline\" (http://hdl.handle.net/11375/32542)"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-7898-8122",
          "name": "Katelyn Mountjoy",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:mcmaster-university-1280-main-st-w-hamilton-on-l8s-4l8-canada",
            "name": "McMaster University, 1280 Main St W, Hamilton, ON L8S 4L8, Canada"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "Tropical cyclones have been found to increase the salinity of the freshwater lens of anchialine aquifers due to increased mixing between the two water masses (i.e., freshwater and marine water), which negatively impacts its potability. Of particular concern is that tropical cyclones have been increasing in both intensity and frequency in the Atlantic region, although there is still some uncertainty and debate regarding the role of climate change in these changes, hindering future projections. One of the problems in examining the relationship between climate change and tropical cyclones is that the observational record is very limited: As experts agree that it is difficult to examine the relationship between climate change and recent trends in hurricane activity given that temperatures have only shown strong increases in the last few decades, one approach is to examine the paleoclimate…"
        }
      ]
    }
  ]
}
