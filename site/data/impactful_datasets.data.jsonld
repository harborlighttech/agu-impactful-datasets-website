      ],
      "name": "World Ocean Database",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0128",
      "agu:stableKey": "title:world ocean database",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "From https://www.ncei.noaa.gov/products/world-ocean-database: The World Ocean Database (WOD) is world's largest collection of uniformly formatted, quality controlled, publicly available ocean profile data. It is a powerful tool for oceanographic, climatic, and environmental research, and the end result of more than 20 years of coordinated efforts to incorporate data from institutions, agencies, individual researchers, and data recovery initiatives into a single database. WOD data spans from Captain Cook's 1772 voyage to the contemporary Argo period, making it a valuable resource for long term and historical ocean climate analysis. Original versions of the 20,000+ datasets in the WOD are available through the NCEI archives. The WOD consists of periodic major releases and quarterly updates to those releases. Each major release is associated with a concurrent release of the World Ocean Atlas (WOA), and contains final quality control flags used in the WOA, which includes manual as well as automated steps. Each quarterly update release includes additional historical and recent data and…",
      "url": "https://www.ncei.noaa.gov/products/world-ocean-database",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:current-wod-version-authors-mishonov-a-v-t-p-boyer-o-k-baranova-c-n-bo",
          "name": "current (WOD@#) version authors: Mishonov A.V., T. P. Boyer, O. K. Baranova, C. N. Bouchard, S. Cross, H. E. Garcia, R. A. Locarnini, C. R. Paver, J. R. Reagan, Z. Wang, D. Seidov, A. I. Grodsky, J. G. Beauchamp"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:mishonov-a-v-t-p-boyer-o-k-baranova-c-n-bouchard-s-cross-h-e-garcia-r",
          "name": "Mishonov A.V., T. P. Boyer, O. K. Baranova, C. N. Bouchard, S. Cross, H. E. Garcia, R. A. Locarnini, C. R. Paver, J. R. Reagan, Z. Wang, D. Seidov, A. I. Grodsky, J. G. Beauchamp"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:us-national-centers-for-environmental-information",
        "name": "US National Centers for Environmental Information"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-0957-5444",
          "name": "James H. Swift",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:scripps-institution-of-oceanography-ucsd-8622-kennel-way-la-jolla-ca-9",
            "name": "Scripps Institution of Oceanography, UCSD, 8622 Kennel Way, La Jolla, CA 92037"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "It is difficult to imagine modern oceanographic research without the NOAA/NCEI World Ocean Database. The database is used in myriad analyses, models, and data products. It represents the complete known global hydrography (in the oceanographic sense) over approximately the last century—indeed, extending even further back, although the data from the earliest cruises included in the WOD are outside this nominator’s field of interest. Its background files are where new hydrographic data are deposited for community use and safe archive."
        }
      ]
    },
