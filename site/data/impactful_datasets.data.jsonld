          "name": "Lynn deWitt, NOAA & Margaret O'Brien"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:edi",
        "name": "EDI"
      },
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "The CalCOFI larval fish dataset has been widely reused in fisheries, ecosystem, and climate research for over seven decades. It underpins numerous stock assessments and Fisheries Management Plans.…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-0177-7770",
          "name": "Erin Satterthwaite",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:scripps-institution-of-oceanography-ucsd-8622-kennel-way-la-jolla-ca-9",
            "name": "Scripps Institution of Oceanography, UCSD, 8622 Kennel Way, La Jolla, CA 92037"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The CalCOFI larval fish dataset was nominated because it showcases how sustained, open-access ocean observations advance both science and society. Founded in the aftermath of the catastrophic Pacific sardine collapse of the 1940s, CalCOFI was created to understand the complex interplay between environmental variability and fishery productivity. Over nearly eight decades, this dataset has evolved from a response to a devastating economic and cultural collapse into a globally recognized foundation for ecosystem-based research and management, education, and conservation. Prosperity -- CalCOFI data are essential for sustainable fisheries and ecosystem-based management along California and the U.S. West Coast. They inform state Fisheries Management Plans and provide key insights into distribution, recruitment, and links between ocean conditions and larval abundance. CalCOFI larval indices…"
        }
      ]
    },
