      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "GNIP is a worldwide observation network of stable isotope and tritium in monthly precipitation samples initiated in 1960 by the IAEA and the World Meteorological Organization (WMO) and is operated in cooperation with numerous partner institutions in IAEA Member States.",
      "url": "https://nucleus.iaea.org/wiser",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:iaea-many",
          "name": "IAEA - many"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:iaea",
        "name": "IAEA"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-9966-5915",
          "name": "Nina Welti",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:csiro-clunies-ross-street-black-mountain-canberra-act-2601",
            "name": "CSIRO, Clunies Ross Street, Black Mountain, Canberra, ACT 2601"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This database provides a long-term global record of the isotopic composition of rainfall and snowfall. Its establishes a worldwide collection network that creates a global community around stable isotopes applications in hydrology and other domains. This dataset connects climate science, hydrology, ecology, and environmental monitoring into a cohesive understanding of Earth’s water and climate systems. This long-term record allows us to create global, continental, and regional models of the water cycle. IGNIP data underpin early-warning systems for droughts and floods, as isotopic hydrology reveals precursors and water-source origins critical for forecasting extreme weather events, such as drought.In Australia, where regional climate variability and water-cycle changes are increasing the occurrence and duration of drought, such data is invaluable to compare changes happening at multiple…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0056",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0056",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0056"
        }
      ],
      "name": "Global Ocean Data Analysis Project (GLODAP)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0056",
      "agu:stableKey": "title:global ocean data analysis project (glodap)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "The Global Ocean Data Analysis Project (GLODAP) is a synthesis of over 1100 cruises including more than 1.4 million water samples of surface so bottom biogeochemical data for 13 core chemical oceanographic variables (salinity, oxygen, nitrate, silicate, phosphate, dissolved inorganic carbon, total alkalinity, pH, CFC-11, CFC-12, CFC-113, CCl4, and SF6). The data undergoes primary and secondary quality control to identify and flag outliers, and to adjust for measurement offsets. The result is a merged and internally consistent data product of global ocean biogeochemical variables from 1972 to the present. First released in 2004, a major updated version 2 was released in 2016 with annual updates starting in 2019. An updated third version which re-evaluates all data is currently in production. The dataset is freely available and has been used in hundreds of studies on the carbon cycle, climate change, biogeochemical cycles, and ocean acidification. The secondary quality control procedure allows scientists to determine and evaluate changes in ocean chemistry over nearly 50 years. It…",
      "url": "https://glodap.info",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:glodap-reference-group-https-glodap-info-index-php-group",
          "name": "GLODAP reference group (https://glodap.info/index.php/group/)"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:glodap-reference-group",
          "name": "GLODAP reference group"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:https-glodap-info-index-php-merged-and-adjusted-data-product-v2-2023",
        "name": "https://glodap.info/index.php/merged-and-adjusted-data-product-v2-2023/"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Olsen, A., et al. (2016). The Global Ocean Data Analysis Project version 2 (Glodapv2) – an internally consistent data product for the world ocean. Earth System Science Data, 8(2), 297–323. https://doi.org/10.5194/essd-8-297-2016"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "https://glodap.info/index.php/glodap-impact/"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-2008-7751",
          "name": "Ryan Woosley",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:massachusetts-institute-of-technology-center-for-sustainability-scienc",
            "name": "Massachusetts Institute of Technology, Center for Sustainability Science and Strategy, Department of Earth, Atmospheric, and Planetary Sciences, 77 Massachusetts Avenue, Cambridge, MA 02139"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset is extremely valuable to the AGU community. Including all versions, it has been cited over 1600 times. It is considered by many to be the gold standard for global biogeochemical ocean observations, particularly for the inorganic carbon system, but also for temperature, salinity, oxygen, nutrients, and ocean tracers (e.g. CFCs). This is because not only does it compile observations from today and going back as early as the 1970s, but it applies secondary quality control procedures to ensure consistency in data across five decades. This allows for methodological changes and improvements to measurement quality over time to be accounted for and minimize spurious results due to systematic measurement uncertainties. This dataset has allowed for the current state of ocean carbon cycle and sink to be determined and global scales changes due to human activities to be quantified…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0057",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0057",
      "identifier": [
        {
          "@type": "PropertyValue",
