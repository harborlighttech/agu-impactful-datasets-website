      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-2822-8261",
          "name": "Nils Moosdorf",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:leibniz-centre-for-tropical-marine-research-zmt-fahrenheitstra-e-6-283",
            "name": "Leibniz Centre for Tropical Marine Research (ZMT), Fahrenheitstraße 6, 28359 Bremen, Germany"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The Global Lithological Map (GLiM) was nominated because it is the by far highest-resolution portrayal of the Earth’s surface geology. Compiled over six years by a small research team without structured data infrastructure, GLiM unified 90 regional geological maps into a coherent global lithological framework, of more than a million polygons, sometimes digitizing analogue archives, e.g. scanned Soviet paper maps by hand. Each mapped unit was systematically translated into standardized lithological classes sometimes relying on additional literature research. The result is a high-resolution representation of the planet’s rock composition. Since publication, GLiM has become a cornerstone dataset directly cited in more than a thousand studies. Through sibling-datasets developed from it, GLiM improves nearly all research of the Earth System that includes aspects of the terrestrial…"
        }
      ]
    },
    {
      "@type": "Dataset",
