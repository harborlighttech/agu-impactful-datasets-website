      ],
      "name": "The Collaborative Carbon Column Observing Network (COCCON)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:atmos"
      },
      "agu:datasetId": "agu-0114",
      "agu:stableKey": "title:the collaborative carbon column observing network (coccon)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 0,
      "description": "COCCON is a network of small, portable Fourier-transform infrared spectrometers that measure near-IR solar spectral from which total columns of CO2, CH4, and (in most cases) CO can be derived. The smaller size, lower cost, and robustness of these instruments allows them to be deployed in networks around emission sources or remote locations where more expensive and complex instruments are impractical.",
      "url": "https://www.imkasf.kit.edu/english/COCCON.php",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:frank-hase",
          "name": "Frank Hase"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:darko-dubravica",
          "name": "Darko Dubravica"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:all-of-the-coccon-pis",
          "name": "all of the COCCON PIs"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:institute-of-meteorology-and-climate-research-atmospheric-trace-gases",
        "name": "Institute of Meteorology and Climate Research Atmospheric Trace Gases and Remote Sensing"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Frey, M., et al. (2019). Building the collaborative carbon column observing network (Coccon): Long-term stability and ensemble performance of the em27/sun fourier transform spectrometer. Atmospheric Measurement Techniques, 12(3), 1513–1530. https://doi.org/10.5194/amt-12-1513-2019"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-8599-4555",
          "name": "Josh Laughner",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:jet-propulsion-laboratory-california-institute-of-technology-4800-oak",
            "name": "Jet Propulsion Laboratory, California Institute of Technology, 4800 Oak Grove Dr., La Cañada Flintridge, CA 91011"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "COCCON plays an important role in both direct observation of carbon emissions and validation of carbon observing satellites. For direct observation, the small size and relative affordability of the instruments allow multiple instruments to be deployed around an emission source, such as an urban area or landfill. The gradient in column-average CO2 or CH4 between the instruments up- and down- wind of the source provides a top-down constraint on the emissions from that area. The column averages measured by these instruments are mostly insensitive to vertical transport of the emissions; compared to a surface concentration measurement, this reduced uncertainty caused by the potential to miss emissions lofted above the surface. For satellite validation, it is vital to have ground-truth column averages of CO2 or CH4 with which to compare the satellite products. Like its sibling network, TCCON,…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0115",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0115",
      "identifier": [
        {
          "@type": "PropertyValue",
