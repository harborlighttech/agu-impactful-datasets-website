        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:airnow",
        "name": "AirNOW"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-1965-9051",
          "name": "Dan Jaffe",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-washington-1410-ne-campus-parkway-seattle-wa-98195",
            "name": "University of Washington, 1410 NE Campus Parkway, Seattle, WA 98195"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset/website provides real time smoke information across the US and much of Canada. It is widely used, both by researchers and the general public as a tool to understand smoke occurrence and to protect public health. The site developers integrated not only regulatory air quality data, but also crowd sourced Purple Air data, which provides much greater geographic coverage. This was a very innovative move and took a lot of work to ensure data comparability."
        }
      ]
