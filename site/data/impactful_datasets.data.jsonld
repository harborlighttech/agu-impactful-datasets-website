        },
        {
          "@type": "CreativeWork",
          "text": "Intergovernmental Panel On Climate Change (Ipcc). (2023). Climate Change 2021 – The Physical Science Basis: Working Group I Contribution to the Sixth Assessment Report of the Intergovernmental Panel…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-8151-4684",
          "name": "Thomas Westerhold",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:marum-center-for-marine-environmental-sciences-at-the-university-of-br",
            "name": "MARUM – Center for Marine Environmental Sciences at the University of Bremen, Leobener Straße 8, 28359 Bremen, Germany"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The Cenozoic Global Reference Benthic Carbon and Oxygen Isotope Dataset (CENOGRID) represents a significant advance in the field of climate science, enabling researchers to compile a continuous, high-fidelity record of variations in Earth's climate extending 66 million years into the past. This development marks a remarkable milestone in the field, allowing scientists to make unprecedented observations and advances in their understanding of climate dynamics over long periods of time. The record indicates the presence of four distinct climate states, dubbed Hothouse, Warmhouse, Coolhouse, and Icehouse. More than 5 decades of scientific ocean drilling and collaborative research across multiple international entities was needed to enable the reconstruction of the fine-scale rhythmic variability of past climates. CENOGRID effectively captures natural climate variability and shows that…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0031",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0031",
      "identifier": [
        {
          "@type": "PropertyValue",
