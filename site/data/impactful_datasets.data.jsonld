      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Crisp, D. (2015). Measuring atmospheric carbon dioxide from space with the Orbiting Carbon Observatory-2 (OCO-2) (J. J. Butler, X. (Jack) Xiong, & X. Gu, Eds.; p. 960702). https://doi.org/10.1117/12.2187291"
        }
      ],
      "agu:reuseExample": [
