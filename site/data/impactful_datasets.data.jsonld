      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-6638-5543",
          "name": "Dominique Weis",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-british-columbia-earth-ocean-and-atmopsheric-sciences-22",
            "name": "University of British Columbia, Earth, Ocean and Atmopsheric Sciences, 2207 Main Mall #2020, Vancouver, BC V6T 1Z4, Canada"
          },
          "agu:sequence": 1
        },
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-6592-9270",
          "name": "Marthe Klöcking",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:institute-for-mineralogy-university-of-m-nster-corrensstr-24-48149-m-n",
            "name": "Institute for Mineralogy, University of Münster, Corrensstr. 24, 48149 Münster, Germany"
          },
          "agu:sequence": 2
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "PetDB was nominated because it is one of the most useful databases for geochemists, or anyone using elemental (major, trace element concentrations) or isotope data. The nominator also used the dataset in training an undergraduate level courses."
        },
        {
          "@type": "CreativeWork",
          "agu:sequence": 2,
          "text": "PetDB is a comprehensive and enduring open-access geochemical compilation of laboratory analytical data of rocks and minerals from the ocean floor and global mantle xenoliths. It contains harmonized chemical and isotopic data for volcanic, igneous and metamorphic rocks, integrating decades of analyses published in the academic literature. PetDB offers a highly customisable web search that has enabled research across disciplines as well as Earth Sciences teaching. PetDB is managed by the EarthChem system, which also provides joint data access with 5 other distinct geochemical databases. Amongst many other collaborations, EarthChem partnered with the Carleton College to develop a set of robust, freely available teaching resources for Earth Science students as well as the general public (https://serc.carleton.edu/research_education/cyberinfrastructure/listings.html). About 15% of users…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0011",
