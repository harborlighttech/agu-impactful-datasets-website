      ],
      "name": "Geoscope Network Seismic Data",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:interior"
      },
      "agu:datasetId": "agu-0049",
      "agu:stableKey": "title:geoscope network seismic data",
      "agu:nominatorCount": 1,
      "agu:citationCount": 2,
      "agu:reuseCount": 2,
      "description": "The GEOSCOPE network (G) is a global seismological network created in 1982 to respond to the challenge of instrumenting isolated sites all around the world. The GEOSCOPE network is primarily dedicated to research and its data are used for studies of Earth structure and dynamics, seismic sources, time dependent seismology and environmental seismology. Most of the stations include a very broad band seismometer (STS1 or new generation T360), and the remaining ones a broadband seismometer (STS2 or T120/240). Stations are usually installed in vaults with special equipments aimed at reducing long period noise related to atmospheric pressure variation. Data of all stations are publicly available, both in real-time and after final validation, at the IPGP, Epos-France and Earthscope data centers.",
      "url": "http://geoscope.ipgp.fr/networks/detail/G/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:institut-de-physique-du-globe-de-paris-ipgp-and-ecole-et-observatoire",
          "name": "Institut de Physique du Globe de Paris (IPGP) and Ecole et Observatoire des Sciences de la Terre de Strabourg (EOST)"
        }
      ],
      "agu:curator": [
