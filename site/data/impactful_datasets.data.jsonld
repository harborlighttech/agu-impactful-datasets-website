        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "It is the anchor time series of global warming."
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0117",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0117",
