      "name": "2020 TCCON Data Release",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:atmos"
      },
      "agu:datasetId": "agu-0001",
      "agu:stableKey": "title:2020 tccon data release",
      "agu:nominatorCount": 9,
      "agu:citationCount": 3,
      "agu:reuseCount": 9,
      "description": "The TCCON release contains data from 30+ ground based FTIRs located in over a dozen nations around the world. The files include total column averages of atmospheric trace gases, including but not limited to CO2, CH4, CO, N2O, HF, H2O, HDO, and O2 along with the ancillary information necessary to compare the column amounts to in situ, space-based, or model observations of the same gases. The TCCON data are widely used for satellite validation and carbon cycle studies.",
      "url": "https://tccondata.org/",
