      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-4268-6322",
          "name": "Ted A Scambos",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-colorado-boulder-boulder-co-80309",
            "name": "University of Colorado Boulder, Boulder, CO 80309"
          },
          "agu:sequence": 1
