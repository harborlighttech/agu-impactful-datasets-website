      "name": "A Comprehensive Northern Hemisphere Particle Microphysics Dataset from the Precipitation Imaging Package",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0011",
      "agu:stableKey": "title:a comprehensive northern hemisphere particle microphysics dataset from the precipitation imaging package",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 3,
      "description": "This dataset was nominated because precipitation impacts the daily lives of people across the world, from extreme rainfall events, to large hail storms, to snow causing delays during morning commutes to work. However, accurate prediction of precipitation is challenging due to the wide variety of conditions that can influence the type and intensity of the precipitation event, leading to large uncertainty and error in model predictions. This work aims to help improve understanding of precipitating processes by providing a large, robust dataset of observations spanning 10 years across multiple regional climates. This dataset can then be used to train more accurate models to better predict and respond to changing weather patterns, improving people's daily lives. The dataset is open access, with tools for easily interacting with the data so that others can re-use and build upon what has been developed.",
      "url": "https://deepblue.lib.umich.edu/data/concern/data_sets/kk91fm40r",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:fraser-king-claire-pettersen",
          "name": "Fraser King, Claire Pettersen"
