      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-6394-7651",
          "name": "Zachary Labe",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:climate-central-1-palmer-square-e-suite-315-princeton-nj-08542",
            "name": "Climate Central, 1 Palmer Square E, Suite 315, Princeton, NJ 08542"
          },
