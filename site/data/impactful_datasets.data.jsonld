        "@id": "urn:org:agu:data:impactful-datasets:id:organization:harvard-dataverse",
        "name": "Harvard Dataverse"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Gao, J., & O’Neill, B. C. (2020). Mapping global urban land for the 21st century with data-driven simulations and Shared Socioeconomic Pathways. Nature Communications, 11(1), 2302. https://doi.org/10.1038/s41467-020-15788-7"
        },
