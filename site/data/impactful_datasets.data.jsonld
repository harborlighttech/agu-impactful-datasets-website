        },
        {
          "@type": "CreativeWork",
          "text": "Bai, J.-H., Liu, F., Zhang, Z.-F., Ma, J.-L., Zhang, L., Liu, Y.-F., Zhong, S.-X., & Wei, G.-J. (2021). Simultaneous measurement stable and radiogenic Nd isotopic compositions by MC-ICP-MS with a…"
        }
