      ],
      "name": "Magellan Global Topography, Emissivity, Reflectivity, and Slope Data Record (GXDR)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:space"
      },
      "agu:datasetId": "agu-0084",
      "agu:stableKey": "title:magellan global topography, emissivity, reflectivity, and slope data record (gxdr)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "The nominator described this as the essential dataset to understand and constrain any current work on the surface of Venus, in preparation for the upcoming space missions. Made in the 1990s, the dataset still holds an enormous relevance today as the primary global source of surface properties. Built from the retracking of Magellan altimetry power echoes and their projection on a global grid, this dataset provides elevation data across approx. 98% of the surface of Venus, at a 10-30 km spatial resolution. Parallel to each elevation value, the dataset provides estimates of km-scale roughness as well as Fresnel reflectivity, derived from the Hagfors fit applied to the echoes.",
      "url": "https://pds-geosciences.wustl.edu/missions/magellan/gxdr/index.htm",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:peter-ford-gordon-pettengill-fang-liu-joan-quigley",
          "name": "Peter Ford, Gordon Pettengill, Fang Liu, Joan Quigley"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:planetary-data-system",
        "name": "Planetary Data System"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Ford, P. G., and G. H. Pettengill (1992), Venus topography and kilometer-scale slopes, J. Geophys. Res., 97(E8), 13103–13114, doi:10.1029/92JE01085."
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Gallardo i Peres, G., Mason, P. J., & Ghail, R. C. (2025). A map of potential topographic anomalies on Venus. Journal of Geophysical Research: Planets, 130, e2024JE008778.…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0009-0003-9668-5138",
          "name": "Gerard Gallardo i Peres",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:imperial-college-london-exhibition-road-south-kensington-london-sw7-2a",
            "name": "Imperial College London, Exhibition Road, South Kensington, London SW7 2AZ, United Kingdom"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset was nominated because it includes the only available global topography of Venus with the best resolution to date, and it still provides the best suite of ancillary information to constraint many geological, geomorphological and planetary studies of the planet Venus. Thirty five years ago, Magellan was the last radar/surface mission to the planet, mapping the surface from 1990 to 1992. Since there are currently at least three radar payloads in development, to explore Venus again across the next decade (dubbed “The Decade of Venus”), the usefulness of its data has suddenly been reinvigorated, and its information is critically relevant to inform the design of these new radar instruments. In the nominator’s opinion, it is therefore a dataset we should focus on now in preparation for the missions; not only because it provides a currently irreplacable knowledge of the surface,…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0085",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0085",
      "identifier": [
