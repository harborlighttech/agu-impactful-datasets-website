      "name": "Neotoma Paleoecology Database",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0090",
      "agu:stableKey": "title:neotoma paleoecology database",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "The Neotoma Paleoecology Database supports global-change research by providing an open, high-quality, and community-curated resource for paleoecological and paleoenvironmental data. Neotoma comprises three interwoven components: the data itself (time series of fossil abundances or proxies of past environmental conditions, from sites distributed worldwide), the software services that make these data available to a variety of user communities, and the community of people who steward and use these data.",
      "url": "https://www.neotomadb.org/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:neotoma-is-governed-by-the-neotoma-leadership-council-a-14-member-elec",
          "name": "Neotoma is governed by the Neotoma Leadership Council, a 14-member elected body. The 2026 NLC is: Quinn Asena, Jessica Blois, Don Charles, Thomas Giesecke, Suzette Flantua, Graciela Gil-Romera, Annika Herbert, Sarah Ivory, Bérangère Leys, Claudio Latorre, Suzanne Pilaar Birch, Alison Smith, Nichola Strandberg, John W. (Jack) Williams"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:neotoma-is-supported-by-a-community-of-dozens-of-data-stewards-who-upl",
          "name": "Neotoma is supported by a community of dozens of Data Stewards, who upload and curate data in Neotoma."
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:data-governance-and-management-is-handled-by-neotoma-s-network-of-cons",
          "name": "Data governance and management is handled by Neotoma's network of Constituent Databases, each of which curates a particular kind of paleoenvironmental proxy data, organized by proxy type, region, and/or geological time work. Within this network, dozens of Data Stewards, upload and curate data in Neotoma."
        }
      ],
      "includedInDataCatalog": {
