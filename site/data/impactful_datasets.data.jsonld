      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-3132-6228",
          "name": "Jonathan Hanson",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:new-zealand-institute-for-earth-sciences",
            "name": "New Zealand Institute for Earth Sciences"
          },
          "agu:sequence": 1
