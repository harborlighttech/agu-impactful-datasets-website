          "@type": "CreativeWork",
          "text": "A working list of the papers that reference ArcticDEM and REMA can be found here: https://z.umn.edu/arcticdem-rema-citations"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0009-0005-4979-9778",
          "name": "Claire Porter",
