      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Sánchez‐Murillo, R., et al. (2025). Stable isotope tempestology of tropical cyclones across the North Atlantic and Eastern Pacific Ocean basins. Annals of the New York Academy of Sciences, 1543(1), 145–165. https://doi.org/10.1111/nyas.15274"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Scientific Publications: Portions of the dataset have supported peer-reviewed studies on tropical cyclone isotope hydrology, including analyses of storm structure, moisture source attribution, and…"
        },
        {
          "@type": "CreativeWork",
          "text": "Derived Data Products: Time series of storm isotopes have been incorporated into regional precipitation isotope maps and event-based datasets that inform hydrologic models of groundwater recharge and…"
        },
        {
          "@type": "CreativeWork",
          "text": "Educational Resources: The dataset has been used in graduate seminars, training workshops, and undergraduate research projects as a case study for teaching isotope hydrology and extreme event…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-8721-8093",
          "name": "Ricardo Sanchez-Murillo",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:the-university-of-texas-at-arlington-701-s-nedderman-dr-arlington-tx-7",
            "name": "The University of Texas at Arlington, 701 S Nedderman Dr, Arlington, TX 76019"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The STORM tropical cyclone isotope database represents a unique and impactful contribution to science and society. It brings together more than three decades of isotopic observations from 40 tropical cyclones, spanning tropical depressions through Category 5 hurricanes, across the North Atlantic and Eastern Pacific basins. By integrating archived records with recent high-frequency (hourly to daily) precipitation, surface water, and groundwater samples, this dataset enables analyses that simply could not exist otherwise: the isotope \"fingerprints\" of storms that drive some of the most damaging hydrometeorological events on Earth. People: Without this dataset, researchers, students, and local agencies would lack a systematic reference for training in isotope hydrology applied to extreme events. The data allow instructors and students to explore storm processes in real time and provide a…",
          "agu:impactDimension": [
            {
              "@type": "DefinedTerm",
              "name": "People",
              "description": "Without this dataset, researchers, students, and local agencies would lack a systematic reference for training in isotope hydrology applied to extreme events. The data allow instructors and students to explore storm processes in real time and provide a foundation for the next generation of scientists working at the intersection of meteorology, hydrology, and geochemistry. Critically, the database supports disaster…"
            },
            {
              "@type": "DefinedTerm",
              "name": "Planet",
              "description": "Tropical cyclones are a major driver of Earth’s water and energy cycles. The dataset advances fundamental geophysical understanding by documenting how storm systems redistribute moisture across the tropics and subtropics. It offers a new lens on climate variability and change, providing indicators of how the isotopic composition of storms responds to shifts in sea-surface temperature, storm tracks, and atmospheric…"
            },
            {
              "@type": "DefinedTerm",
              "name": "Prosperity",
              "description": "This resource fosters community resilience and humanitarian preparedness. By illuminating how and where storm rainfall infiltrates aquifers or replenishes reservoirs, the dataset supports equitable water management, particularly in vulnerable regions that rely on cyclones for a large portion of annual rainfall. It offers applied insights for infrastructure planning, flood mitigation, and post-disaster recovery.…"
            }
          ]
        }
      ]
    },
    {
      "@type": "Dataset",
