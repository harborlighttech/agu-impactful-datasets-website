    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0016",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0016",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0016"
        }
      ],
      "name": "Airborne and Satellite Investigation of Air Quality",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:atmos"
      },
      "agu:datasetId": "agu-0016",
      "agu:stableKey": "title:airborne and satellite investigation of air quality",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 2,
      "description": "The ASIA-AQ dataset provides comprehensive observations of atmospheric composition collected during a two-month airborne field study conducted in February-March of 2024. ASIA-AQ employed two research aircraft to sample key Asian megacities (Manila, Philippines; Seoul, South Korea; Bangkok, Thailand; and Kaohsiung, Taiwan). The NASA DC-8 carried a payload of 26 instruments for in situ sampling of gaseous and fine particle pollution accounting for over 100 individual compounds as well as particle number, size distributions, physical properties, and chemical composition. The NASA G-III carried a remote sensing payload that included a UV-Vis spectrometer to map distributions of two key pollutants, nitrogen dioxide and formaldehyde, and a high spectral resolution lidar to measure the 3-D distribution of ozone and fine particle pollution. At least four flight days were dedicated to each location, completing circuits to sample the city and surrounding areas three times per day. The data complements ground-based monitoring and satellite observations from South Korea’s Geostationary…",
      "url": "https://www-air.larc.nasa.gov/missions/asia-aq/index.html",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:asia-aq-science-team",
          "name": "ASIA-AQ Science Team"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:nasa-asdc",
          "name": "NASA ASDC"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:nasa-langley-atmospheric-science-data-center",
        "name": "NASA Langley Atmospheric Science Data Center"
      },
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Minisini D, Eldrett J, Bergman SC, Forkner R."
        },
        {
          "@type": "CreativeWork",
          "text": "2018. Basin infill history of the organic-rich Eagle Ford Group, Texas, USA. Sedimentology 65:1520–1557. https://doi.org/10.1111/sed.12437"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-6982-0934",
          "name": "James Crawford",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:nasa-langley-research-center-21-langley-blvd-hampton-va-23681",
            "name": "NASA Langley Research Center, 21 Langley Blvd, Hampton, VA 23681"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "ASIA-AQ fully exercised an integrated observing system for air quality that combined airborne measurements with air quality observations from satellites and regulatory ground-monitoring networks. Satellite observations of air quality on an hourly basis have only recently become available with South Korea’s GEMS instrument providing broad coverage over Asia from geostationary orbit. These satellite observations complement ground-based monitoring, which is spatially limited, but satellites observe the total atmospheric column and determining conditions at the surface can be challenging. Providing airborne observations to sample conditions aloft during a short field intensive provides critical information on how to best interpret satellite observations and use them to extend information from surface networks. The combined dataset also provides the most detailed characterization of the…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0017",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0017",
      "identifier": [
        {
          "@type": "PropertyValue",
