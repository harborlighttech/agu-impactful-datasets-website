        "@id": "urn:org:agu:data:impactful-datasets:id:organization:jet-propulsion-laboratory-and-national-snow-and-ice-data-center",
        "name": "Jet Propulsion Laboratory, and, National Snow and Ice Data Center"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Gardner, Alex, Fahnestock, Mark, & Scambos, Ted. (2022). Measures its_live landsat image-pair glacier and ice sheet surface velocities, version 1 [Dataset]. NASA National Snow and Ice Data Center Distributed Active Archive Center. https://doi.org/10.5067/IMR9D3PEI28U"
