        }
      ],
      "name": "NOAA Climate Data Records",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0091",
      "agu:stableKey": "title:noaa climate data records",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 2,
      "description": "NOAA Climate Data Records (CDRs) can be used to manage natural resources and agriculture, measure environmental impacts on human health and community preparedness, and inform policy development and decision making for other sectors and interest groups. CDRs are robust, sustainable, and scientifically sound climate records that provide trustworthy information on how, where, and to what extent the land, oceans, atmosphere and ice sheets are changing. These datasets are thoroughly vetted time series measurements with the longevity, consistency, and continuity to assess and measure climate variability and change. NOAA CDRs are vetted using standards established by the National Research Council (NRC). NOAA CDRs are systematically generated and routinely assessed for quality. The first step in establishing an operational CDR includes public posting of the source code that generated the CDR dataset, the dataset itself, and supporting documentation through a six-phase Research-to-Operations process that is described in the Developers Guidelines. NOAA CDRs are derived from a variety of…",
      "url": "https://www.ncei.noaa.gov/products/climate-data-records",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:national-centers-for-environmental-information",
          "name": "National Centers for Environmental Information"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:noaa-national-centers-for-environmental-information",
        "name": "NOAA National Centers for Environmental Information"
      },
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Minisini, D; Eldrett, JS & Bergman, SC."
        },
        {
          "@type": "CreativeWork",
          "text": "2025. The value of integrated high-resolution studies: The Eagle Ford example. https://doi.org/10.5724/gcs.38.177"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-6850-3403",
          "name": "Yuhan \"Douglas\" Rao",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:north-carolina-state-university-2200-hillsborough-st-raleigh-nc-27607",
            "name": "North Carolina State University, 2200 Hillsborough St, Raleigh, NC 27607"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "NOAA Climate Data Records (CDR) are a collection of nearly 40 datasets that provide unique insight of how the Earth system has changed across different components, including atmosphere, ocean, cryosphere, hydrosphere, and ecosphere. These datasets include dozens of essential climate variables (ECVs) derived from long-term environmental satellite observations through rigorous calibration to remove the impact of satellite platform and sensor changes. They contribute directly to a global network of satellite-based ECVs for climate monitoring that is demanded by the Global Climate Observing Systems (GCOS). These datasets are unique for global climate system monitoring due to its near global coverage. The value of these datasets cannot be replaced with other in situ measurements due to the lack of global representation. Additionally, these CDR datasets are critical to verify the historical…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0092",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0092",
      "identifier": [
