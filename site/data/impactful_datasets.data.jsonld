      ],
      "name": "The GEOROC database",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:interior"
      },
      "agu:datasetId": "agu-0115",
      "agu:stableKey": "title:the georoc database",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 16,
      "description": "The GEOROC Database (Geochemistry of Rocks of the Oceans and Continents) is a comprehensive collection of published datasets with analyses of igneous and metamorphic rocks and minerals. It contains 40.8 million values of major and trace element concentrations, radiogenic and nonradiogenic isotope ratios as well as analytical ages for whole rocks, glasses, minerals and inclusions. Metadata include geospatial and other sample information, analytical method details and source references, which are all fully searchable for downloading custom datasets. The construction of the GEOROC database under the direction of Bärbel Sarbas and Albrecht Hofmann began in January 1998 at the Max Planck Institute for Chemistry, Mainz. GEOROC has been available online since the end of 1999. Since 2006, GEOROC datasets are also available through the EarthChem Portal. The content of the GEOROC database was initially limited to geochemical analyses of ocean island basalts, but was soon expanded to include samples of volcanic rocks from other tectonic environments and the mantle xenoliths they contain as…",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:b-rbel-sarbas",
          "name": "Bärbel Sarbas"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:albrecht-hofmann",
          "name": "Albrecht Hofmann"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:digis-team",
          "name": "DIGIS team"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:digital-geochemical-infrastructure-digis-team",
          "name": "Digital Geochemical Infrastructure (DIGIS) team"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:georoc-eu",
        "name": "georoc.eu"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Lehnert, K., Su, Y., Langmuir, C. H., Sarbas, B., & Nohl, U. (2000). A global geochemical database structure for rocks. Geochemistry, Geophysics, Geosystems, 1(5), 1999GC000026. https://doi.org/10.1029/1999GC000026"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Nominator 1a-1b-1c: Full list of publications citing GEOROC (and PetDB) compiled in July 2024:"
        },
        {
          "@type": "CreativeWork",
          "text": "Klöcking, M., Lehnert, K., Digital Geochemical Infrastructure for GEOROC (DIGIS), & EarthChem. (2025). GEOROC and PetDB data usage and impact through time. Goldschmidt Conference 2024, Chicago.…"
        },
        {
          "@type": "CreativeWork",
          "text": "Selected references that address the People, Planet or Prosperity Dimensions:"
        },
        {
          "@type": "CreativeWork",
          "text": "Bezuidenhout, J. (2021). Estimating indoor radon concentrations based on the uranium content of geological units in South Africa. Journal of Environmental Radioactivity, 234, 106647.…"
        },
        {
          "@type": "CreativeWork",
          "text": "Cooper, J. N., Cooper, A. M., Clausen, B. L., & Nick, K. E. (2018). Regional bedrock geochemistry associated with podoconiosis evaluated by multivariate analysis. Environmental Geochemistry and…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-3317-5697",
          "name": "Anthony Lanati",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:institute-for-mineralogy-university-of-m-nster-corrensstr-24-48149-m-n",
            "name": "Institute for Mineralogy, University of Münster, Corrensstr. 24, 48149 Münster, Germany"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 2,
          "text": "The GEOROC database is one of the most comprehensive and enduring open-access geochemical hard rock compilations in Earth and planetary sciences. It contains harmonized chemical and isotopic data for volcanic, igneous and metamorphic rocks from every tectonic setting on Earth. By integrating over 100 years of published analyses into a consistent, searchable dataset, GEOROC enables reproducible research, long-term data stewardship and global collaboration across disciplines. GEOROC supports education and capacity building in geochemistry and Earth System Science worldwide. It is widely used in courses, workshops and training programs, helping students and researchers develop data literacy and quantitative reasoning skills. Its open accessibility fosters equity in education and research, particularly for communities with limited laboratory resources. Beyond academia, GEOROC contributes to…"
        }
      ]
    },
