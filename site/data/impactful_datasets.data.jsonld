      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:ebrahim-ahmadisharaf",
          "name": "Ebrahim Ahmadisharaf"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:designsafe",
        "name": "DesignSafe"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Ahmadisharaf, E., Pakdehi, M., & Yan, Z. (2024). Machine learning modeling: In rapid: understanding the interrelationships among floods, building characteristics, mold growth and occupants’ asthma symptoms in the aftermath of hurricane Ida. Designsafe-CI. https://doi.org/10.17603/DS2-K1EC-4E35"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "The dataset was applied by Pakdehi et al. (2025; https://doi.org/10.1016/j.envint.2025.109319 and 2026; https://doi.org/10.1016/j.jclepro.2026.148247) to estimate indoor mold and detect new symptoms…"
        },
        {
          "@type": "CreativeWork",
          "text": "The dataset was also discussed in a blog post by Harvard Health (https://www.health.harvard.edu/blog/respiratory-health-harms-often-follow-flooding-taking-these-steps-can-help-202211092848)."
        },
        {
          "@type": "CreativeWork",
          "text": "In a recent news article by WIRED (https://www.wired.com/story/after-hurricane-milton-get-ready-for-mold/), the dataset was discussed to the public on how hurricane can lead to indoor air quality in…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-9452-7975",
          "name": "Ebrahim Ahmadisharaf",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:florida-a-m-university-florida-state-university-college-of-engineering",
            "name": "Florida A&M University-Florida State University College of Engineering, 2525 Pottsdamer St., Tallahassee, FL 32310"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "Flood events continue to damage our society, economy and ecosystem. Recent examples are flooding due to hurricanes (e.g., Helene, Milton and Ida) and heavy precipitation (e.g., July 2025 in Texas and New Mexico). These caused damages to our physical infrastructure and led to fatalities. While these immediate impacts of flooding are well understood, documented and modeled, the longer term impacts such as those on indoor mold due to extensive dampness and moisture are not understood well. These impacts are crucial as excess levels of mold in indoor environments can lead to respiratory health issues like asthma. In particular, systematic fine-scale analyses are lacking. Such impacts are expected to become more pronounced due to more frequent and intense flood events as impacted by climate change and sea level rise. This dataset provides the first fine-scale (building level) dataset that…"
        }
      ]
    },
