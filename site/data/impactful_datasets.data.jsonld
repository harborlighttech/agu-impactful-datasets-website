      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Nana Yobo, L., Brandon, A. D., Lauckner, L. M., Eldrett, J. S., Bergman, S. C., & Minisini, D. (2022). Enhanced continental weathering activity at the onset of the mid-Cenomanian Event (Mce).…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-7036-1977",
          "name": "Kerstin Lehnert",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:lamont-doherty-earth-observatory-columbia-university-61-us-9w-palisade",
            "name": "Lamont-Doherty Earth Observatory, Columbia University, 61 US-9W, Palisades, NY 10964"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The Astromaterials Data System curates and preserves unique data that have been acquired by the study of extremely rare and precious material samples brought back from space. Billions of dollars have been invested into flying space crafts to the Moon and to asteroids billions of miles away, to be able to extract fundamental knowledge from them that expands humanity’s understanding of our solar system and the origin of life. Astromat ensures the long-term impact and Return on Investment of these costly sample-return missions. Astromaterials samples have been studied in laboratories around the globe to determine their chemical, physical, mineralogical, and structural properties. The data generated by these studies are unique and invaluable because measurements cannot be repeated due to the extremely limited quantities of material available. Astromat ensures that the data is carefully and…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0020",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0020",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
