      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:christina-arras",
          "name": "Christina Arras",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:gfz-german-research-centre-for-geosciences-telegrafenberg-14473-potsda",
            "name": "GFZ German Research Centre for Geosciences\nTelegrafenberg\n14473 Potsdam, Germany"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset was nominated because there is no other instrument/measurement system which could provide an altitude resolution for ionospheric irregularities on a global scale in a similar spatial resolution. A single profile contains a variety of information about the state of the atmosphere from Low Earth Orbit (LEO) altitudes down to the Earth’s surface. This dataset supports a wide range of applications, from assessing the state of the ionosphere and monitoring ionospheric irregularities to deriving profiles of lower atmospheric temperature, pressure, and humidity. It can be used to analyze gravity waves, observe tropical cyclones, and enhance weather forecasting accuracy. Therefore, this data set has a vast and beneficial impact on society and research."
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0059",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0059",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0059"
        }
      ],
      "name": "GOSIF and GOSIF GPP (two sister products)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0059",
      "agu:stableKey": "title:gosif and gosif gpp (two sister products)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 2,
      "agu:reuseCount": 2,
      "description": "GOSIF is a global, gridded dataset of solar-induced chlorophyll fluorescence (SIF) produced by the Global Ecology Group at University of New Hampshire. SIF, an energy flux re-emitted by plants a few nanoseconds after light absorption, exhibits a strong linear relationship with gross primary production (GPP) at the ecosystem scale and is a strong proxy of GPP. The GOSIF dataset provides 8-day SIF data globally at 0.05-degree spatial resolution for 2000-2024. This product is derived from discrete SIF observations based on the Orbiting Carbon Observatory-2 (OCO-2) using a machine learning method. The generation of GOSIF also makes use of spatially and temporally continuous data on enhanced vegetation index (EVI) derived from the Moderate Resolution Imaging Spectroradiometer (MODIS) and meteorological reanalysis data from MERRA-2. GOSIF also has a companion product - GOSIF GPP that has the same spatial and temporal coverage and resolutions. GOSIF GPP is a global, gridded GPP product that is based on the GOSIF dataset and established relationships between GPP and SIF. The companion…",
      "url": "https://data.globalecology.unh.edu/data/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:xing-li-jingfeng-xiao",
          "name": "Xing Li, Jingfeng Xiao"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:jingfeng-xiao",
          "name": "Jingfeng Xiao"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:global-ecology-data-repository",
        "name": "Global Ecology Data Repository"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Li, X., Xiao, J. (2019) A global, 0.05-degree product of solar-induced chlorophyll fluorescence derived from OCO-2, MODIS, and reanalysis data. Remote Sensing, 11(5), 517. https://doi.org/10.3390/rs11050517"
        },
        {
          "@type": "CreativeWork",
          "text": "Li, X., Xiao, J. (2019) Mapping photosynthesis solely from solar-induced chlorophyll fluorescence: A global, fine-resolution dataset of gross primary production derived from OCO-2. Remote Sensing, 11(21), 2563; https://doi.org/10.3390/rs11212563"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Allen S, Lee C-T, Minisini D."
        },
        {
          "@type": "CreativeWork",
          "text": "2022. Temporal variations in the composition of Cretaceous Cordilleran arc volcanism through a high-frequency record of bentonites. Earth and Planetary Science Letters 584:117470.…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-0622-6903",
          "name": "Jingfeng Xiao",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:earth-systems-research-center-institute-for-the-study-of-earth-oceans",
            "name": "Earth Systems Research Center, Institute for the Study of Earth, Oceans, and Space, University of New Hampshire, Durham, NH 03824"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "GOSIF and its companion product GOSIF GPP are transformative global datasets whose broad accessibility, consistency, and scientific impact make them outstanding candidates for AGU commentary. Their availability has opened new avenues of inquiry and application across the Earth and environmental sciences—advancing discovery, prediction, and societal benefit in ways that would be severely constrained or impossible without them. The justification below is organized around the dimensions of People, Planet, and Prosperity. 1. People GOSIF and GOSIF GPP have become cornerstone “teaching datasets” in courses and training programs on remote sensing, ecosystem ecology, and the carbon cycle. Their spatially and temporally continuous representations of solar-induced chlorophyll fluorescence (SIF) and gross primary productivity (GPP) allow students and trainees to engage directly with…"
        }
      ]
    },
