      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The dataset was nominated because it provides an unprecedented, continental-scale view of the mechanisms underlying blue carbon sequestration, fundamentally shifting the focus from merely quantifying carbon stocks to discerning how carbon is stabilized over the long term. Without this rich dataset, the ability to leverage coastal ecosystems as a critical nature-based solution to climate change would be severely hampered."
        }
      ]
