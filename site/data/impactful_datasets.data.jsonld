        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-6051-5426",
          "name": "Shane Elipot",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-miami-1320-s-dixie-hwy-coral-gables-fl-33146",
            "name": "University of Miami, 1320 S Dixie Hwy, Coral Gables, FL 33146"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The hourly drifter dataset is, to this date, the only in situ dataset of total near-surface ocean velocity and sea surface temperature that can be used to achieve a global statistical description of the complete spectrum of oceanic near-surface variability. Since its inception, ocean scientists such as myself and others have used this dataset to describe and characterize oceanic motions at a wide range of spatial and temporal scales. These characterizations are not only useful to further test our theoretical understanding of the mechanics of the climate system, but also to evaluate global numerical simulations of this system. These simulations in turn, feed into predictions of the future state of our climate. Beyond the phenomenology of ocean currents for the study of the ocean and the climate as physical systems, this dataset has human, societal, and economic impacts. For example, it…"
        }
      ]
