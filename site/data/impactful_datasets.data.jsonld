      "name": "GEDI02_B GEDI L2B Footprint Level Canopy Cover and Vertical Profile Metrics",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0045",
      "agu:stableKey": "title:gedi02_b gedi l2b footprint level canopy cover and vertical profile metrics",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "The GEDI02_B data product contains 96 layers for each of the eight-beam ground transects (or laser footprints located on the land surface). Datasets provided include precise latitude, longitude, elevation, height, canopy cover, and vertical profile metrics.",
      "url": "https://www.earthdata.nasa.gov/data/catalog/lpcloud-gedi02-b-002",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:dubayah-et-al-2022",
          "name": "Dubayah et al. (2022)"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:land-processes-daac-lp-daac",
        "name": "Land Processes DAAC (LP DAAC)"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-6579-5954",
          "name": "Chris Hakkenberg",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-california-los-angeles-405-hilgard-ave-los-angeles-ca-90",
            "name": "University of California, Los Angeles, 405 Hilgard Ave, Los Angeles, CA 90095"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "GEDI L2B provides the first globally consistent measurements of forest three-dimensional structure, revealing canopy height, layering, and vertical cover that traditional satellites cannot detect. Planet: Without GEDI L2B, we'd lack accurate global forest carbon storage estimates. Conventional imagery shows forest extent but cannot penetrate canopies to measure the vertical architecture determining biomass and carbon capacity. This dataset enables precise carbon stock mapping across all forest types and identifies habitat structures critical for biodiversity conservation—information unavailable from other remote sensing. People: Public accessibility democratizes forest monitoring for under-resourced conservation organizations and developing nations, eliminating expensive field campaigns. Vertical structure metrics improve wildfire behavior modeling and flood risk assessment by…",
          "agu:impactDimension": [
            {
              "@type": "DefinedTerm",
              "name": "Planet",
              "description": "Without GEDI L2B, we'd lack accurate global forest carbon storage estimates. Conventional imagery shows forest extent but cannot penetrate canopies to measure the vertical architecture determining biomass and carbon capacity. This dataset enables precise carbon stock mapping across all forest types and identifies habitat structures critical for biodiversity conservation—information unavailable from other remote…"
            },
            {
              "@type": "DefinedTerm",
              "name": "People",
              "description": "Public accessibility democratizes forest monitoring for under-resourced conservation organizations and developing nations, eliminating expensive field campaigns. Vertical structure metrics improve wildfire behavior modeling and flood risk assessment by characterizing forest fuel distribution and riparian vegetation effects on water flow."
            },
            {
              "@type": "DefinedTerm",
              "name": "Prosperity",
              "description": "The dataset enables evidence-based carbon market verification and REDD+ program monitoring at unprecedented scales, ensuring fair compensation for conservation. Communities can establish credible baselines and document forest protection efforts. It supports sustainable timber planning while helping indigenous groups defend territories against illegal activities. Most critically, without GEDI L2B, we'd measure only…"
            }
          ]
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0046",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0046",
      "identifier": [
