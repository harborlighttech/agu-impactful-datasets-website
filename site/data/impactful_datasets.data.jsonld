      ],
      "name": "OPERA Land Surface Disturbance Alert from Harmonized Landsat Sentinel-2 product (Version 1) OPERA_L3_DIST-ALERT-HLS_V1",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0101",
      "agu:stableKey": "title:opera land surface disturbance alert from harmonized landsat sentinel-2 product (version 1) opera_l3_dist-alert-hls_v1",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 0,
      "description": "The Observational Products for End-Users from Remote Sensing Analysis (OPERA) Land Surface Disturbance Alert from Harmonized Landsat Sentinel-2 (HLS) product Version 1 maps vegetation disturbance alerts that are derived from data collected by Landsat 8 and Landsat 9 Operational Land Imager (OLI) and Sentinel-2A, Sentinel-2B, and Sentinel-2C Multi-Spectral Instrument (MSI). A vegetation disturbance alert is detected at 30 meter (m) spatial resolution when there is an indicated decrease in vegetation cover within an HLS pixel. The Level-3 data product also provides additional information about more general disturbance trends and auxiliary generic disturbance information as determined from the variations of the reflectance through the HLS scenes. Data represent the highest temporal frequency data available at medium spatial resolution. The combined observations will provide greater sensitivity to land changes, whether of large magnitude/short duration or small magnitude/long duration. The data represent the highest temporal frequency data available at medium spatial resolution. The…",
      "url": "https://www.earthdata.nasa.gov/data/catalog/lpcloud-opera-l3-dist-alert-hls-v1-1",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:matthew-hansen-amy-pickens-zhen-song",
          "name": "Matthew Hansen, Amy Pickens, Zhen Song"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:umd-jpl",
          "name": "UMD / JPL"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:opera",
        "name": "OPERA"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "https://www.nature.com/articles/s41467-025-64014-9.epdf"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-1833-3239",
          "name": "Sarah Carter",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:world-resources-institute-wri-europe-bezuidenhoutseweg-105-2594-ac-the",
            "name": "World Resources Institute (WRI) Europe, Bezuidenhoutseweg 105\n2594 AC The Hague, The Netherlands"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The Land Surface Disturbance Alert (DIST-ALERT) dataset delivers the first global, near-real-time monitoring of vegetation disturbance across all terrestrial ecosystems, filling a critical gap in how we detect and respond to land-use change. It expands global alert coverage beyond tropical forests to include grasslands, savannas, shrublands, wetlands, and croplands, enabling rapid detection of deforestation, degradation, and other disturbances anywhere in the world. DIST-ALERT also serves as the foundation for the Land Disturbance Alert Classification System (LDACS), which classifies each disturbance as likely natural or human-driven. Together, these tools allow users not only to detect change as it happens but also to interpret its likely causes—an essential step for targeted conservation, enforcement, and policy action. DIST-ALERT is particularly important for monitoring and…"
        }
      ]
    },
