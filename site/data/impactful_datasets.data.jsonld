      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "The nominator’s team is working on a new manuscript describing the latest version of the dataset. Here is a publication on the previous release:"
        },
        {
          "@type": "CreativeWork",
          "text": "Maasakkers, J. D., McDuffie, E. E., Sulprizio, M. P., Chen, C., Schultz, M., Brunelle, L., Thrush, R., Steller, J., Sherry, C., Jacob, D. J., Jeong, S., Irving, B., & Weitz, M. (2023). A gridded inventory of annual 2012–2018 u. S. Anthropogenic methane emissions. Environmental Science & Technology,…"
        }
