        "name": "Science Data Bank"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Li, Z., Yan, Z., Zhu, Y., Freychet, N., & Tett, S. (2020). Homogenized daily relative humidity series in China during 1960–2017. Advances in Atmospheric Sciences, 37(4), 318–327. https://doi.org/10.1007/s00376-020-9180-0"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-2007-8898",
          "name": "Li Zhen",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:institute-of-atmospheric-physics-chinese-academy-of-sciences-beijing-c",
            "name": "Institute of Atmospheric Physics, Chinese Academy of Sciences, Beijing, China"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset is highly impactful for advancing Earth and environmental science, aligning closely with the \"People, Planet, and Prosperity\" dimensions of sustainable development: Planet Dimension RH is a key driver of atmospheric processes (e.g., fog/haze formation, evapotranspiration) and ecosystem dynamics. Raw RH data previously contained false decreasing trends due to observation system shifts (manual to automated), misleading climate change assessments. The homogenized dataset corrects these biases, enabling accurate quantification of RH’s long-term variability and its link to global warming—critical for understanding changes in hydrological cycles, atmospheric visibility, and terrestrial ecosystems across China. Without it, researchers would overestimate RH decline, leading to flawed conclusions about climate-driven shifts in water vapor balance and associated environmental impacts…"
        }
      ]
    },
