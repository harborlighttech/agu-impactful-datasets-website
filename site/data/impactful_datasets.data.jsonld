      "citation": [
        {
          "@type": "CreativeWork",
          "text": "The following publication describes the initial version of the WorldCereal reference data repository:"
        },
        {
          "@type": "CreativeWork",
          "text": "Boogaard, H., Pratihast, A. K., Laso Bayas, J. C., Karanam, S., Fritz, S., Van Tricht, K., Degerickx, J., & Gilliams, S. (2023). Building a community-based open harmonised reference data repository for global crop mapping. PLOS ONE, 18(7), e0287731. https://doi.org/10.1371/journal.pone.0287731"
        },
        {
          "@type": "CreativeWork",
          "text": "Most recent and up-to-date documentation on this dataset can be found through the WorldCereal documentation portal:"
        },
        {
          "@type": "CreativeWork",
          "text": "https://worldcereal.github.io/worldcereal-documentation/rdm/overview.html"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "WorldCereal global cropland, crop type and irrigation maps 2021:"
        },
        {
          "@type": "CreativeWork",
          "text": "Van Tricht, K., Degerickx, J., Gilliams, S., Zanaga, D., Battude, M., Grosu, A., Brombacher, J., Lesiv, M., Bayas, J. C. L., Karanam, S., Fritz, S., Becker-Reshef, I., Franch, B., Mollà-Bononad, B.,…"
        },
        {
          "@type": "CreativeWork",
          "text": "The resulting global cropland layer has been used by the Joint Research Center of the European Commission to establish a new global crop- and grassland base layer for agricultural Early Warning…"
        },
        {
          "@type": "CreativeWork",
          "text": "European Commission. Joint Research Centre. (2024). Development of a new cropland and rangeland area fraction image at 500 m for the ASAP system. Publications Office.…"
        },
        {
          "@type": "CreativeWork",
          "text": "The dataset is also used as a basis for the production of European-wide, high-resolution crop maps on a yearly basis, as part of the operational Copernicus High Resolution Cropland Layers:"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-2243-2632",
          "name": "Sven Gilliams",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:geoglam-7-bis-avenue-de-la-paix-1211-geneva-switzerland",
            "name": "GEOGLAM, 7 bis Avenue de la Paix, 1211 Geneva, Switzerland"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "In order to effectively monitor food security at global scale and reach the Zero Hunger Sustainable Development Goal, having access to reliable information on the proportion of productive agricultural area is key. Global food security is monitored regularly by initiatives such as GEOGLAM, spearheaded by the Group on Earth Observations (GEO), and the Agricultural Market Information System (AMIS), which rely on accurate and up-to-date information on where major crops are grown and their agricultural productivity. These agricultural monitoring systems however currently rely on static information on the spatial extent of cropland, often produced for a past baseline year and at a coarse resolution, with the location of major crop types often based on downscaling of past national and subnational statistics. The ESA funded WorldCereal project is therefore offering an efficient, agile and…"
        }
      ]
    },
