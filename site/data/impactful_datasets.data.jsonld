        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Weis, D., Harpp, K. S., Harrison, L. N., Boyet, M., Chauvel, C., Farnetani, C. G., Finlayson, V. A., Lee, K. K. M., Parai, R., Shahar, A., & Williamson, N. M. B. (2023). Earth’s mantle composition…"
