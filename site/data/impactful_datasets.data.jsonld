      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-3519-1412",
          "name": "Laurent Montesi",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-maryland-college-park-md-20742",
            "name": "University of Maryland, College Park, MD 20742"
          },
          "agu:sequence": 1
