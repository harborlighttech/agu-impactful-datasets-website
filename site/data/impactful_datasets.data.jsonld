    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0053",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0053",
      "identifier": [
        {
          "@type": "PropertyValue",
