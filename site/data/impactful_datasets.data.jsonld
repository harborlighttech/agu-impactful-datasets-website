      ],
      "name": "AutoTerm",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0023",
      "agu:stableKey": "title:autoterm",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "This dataset contains shapefiles of termini traces from 294 Greenland glaciers, derived using a deep learning algorithm (AutoTerm) applied to satellite imagery. The model functions as a pipeline, imputing publicly available satellite imagery from Google Earth Engine (GEE) and outputting shapefiles of glacial termini positions for each image. Also available are supplementary data, including temporal coverage of termini traces, time series data of termini variations, and updated land, ocean, and ice masks derived from the Greenland Ice Sheet Mapping Project (GrIMP) ice masks. (URL: https://cmr.earthdata.nasa.gov/search/concepts/C2849438379-NSIDCV0.html)",
      "url": "https://cmr.earthdata.nasa.gov/search/concepts/C2849438379-NSIDCV0.html",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:enze-zhang-ginny-catania-daniel-trugman",
          "name": "Enze Zhang, Ginny Catania, Daniel Trugman"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:nsidc",
        "name": "NSIDC"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-6431-2570",
          "name": "Enze Zhang",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:hong-kong-university-of-science-and-technology-clear-water-bay-hong-ko",
            "name": "Hong Kong University of Science and Technology, Clear Water Bay, Hong Kong"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "Glaciers are retreating due to global warming, resulting in significant ice sheet loss and rising sea levels. Historically, scientists manually digitized glacier termini to investigate glacier retreat and its underlying causes, a process that was time-consuming. In recent decades, the proliferation of new satellite sensors has generated a wealth of Earth science data. This vast volume of data renders manual digitization impractical. However, with the combination of enhanced computational power and rapid advancements in deep learning (DL) algorithms, scientists can now create detailed spatiotemporal time series that effectively capture changes in the Earth’s environment. This capability is particularly important for the cryosphere, which is highly sensitive to climate change. Recent studies have shown that DL methods can effectively delineate glacier termini, yet none have successfully…"
        }
      ]
    },
