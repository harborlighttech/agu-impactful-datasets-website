      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-8289-1059",
          "name": "Axel D. Renno",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:helmholtz-institute-freiberg-for-resource-technology-hif-helmholtz-zen",
            "name": "Helmholtz Institute Freiberg for Resource Technology (HIF) Helmholtz-Zentrum Dresden - Rossendorf (HZDR), Chemnitzer Str. 40, 09599 Freiberg, Germany"
          },
          "agu:sequence": 1
