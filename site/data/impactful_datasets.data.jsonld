      "agu:datasetId": "agu-0097",
      "agu:stableKey": "doi:10.5067/70k2b2w8mngy|oco-2 level 2 bias-corrected xco2",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "The Orbiting Carbon Observatory is the first NASA mission designed to collect space-based measurements of atmospheric carbon dioxide with the precision, resolution, and coverage needed to characterize the processes controlling its buildup in the atmosphere. The OCO-2 project uses the LEOStar-2 spacecraft that carries a single instrument. It incorporates three high-resolution spectrometers that make coincident measurements of reflected sunlight in the near-infrared CO2 near 1.61 and 2.06 micrometers and in molecular oxygen (O2) A-Band at 0.76 micrometers.",
      "url": "https://doi.org/10.5067/70K2B2W8MNGY",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:oco-2-oco-3-science-team-vivienne-payne-abhishek-chatterjee",
          "name": "OCO-2/OCO-3 Science Team, Vivienne Payne, Abhishek Chatterjee"
        }
      ],
      "includedInDataCatalog": {
