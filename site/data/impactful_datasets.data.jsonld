      ],
      "name": "Astromaterials Data Synthesis",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:space"
      },
      "agu:datasetId": "agu-0019",
      "agu:stableKey": "title:astromaterials data synthesis",
      "agu:nominatorCount": 1,
      "agu:citationCount": 3,
      "agu:reuseCount": 1,
      "description": "The Astromaterials Data System (Astromat) is a comprehensive data collection of laboratory analyses of samples returned from space, including samples collected on the Moon during the Apollo missions, samples collected from asteroids Bennu and Ryuku, and samples of solar wind and cosmic dust. It also contains meteorite data, including the entire content of the MetBase database. With funding from NASA, Astromat has restored a vast volume of legacy data generated since the 1970s and now is NASA’s designated archive of laboratory analytical data from recent and future sample-return missions (OSIRIS-REx, Artemis, MARS2020). Astromat compiles and curates both legacy and new compositional data of returned samples into the Astromat Data Synthesis that can be explored via an interactive search interface and subsets of the data can be extracted, fully customized to the needs of the user. The Astromat Data Archive is a CoreTrustSeal certified data repository with thousands of well-documented datasets archived for long-term preservation and access.",
      "url": "https://www.astromat.org",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:kerstin-lehnert",
          "name": "Kerstin Lehnert"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:geoinformatics-research-group-lamont-doherty-earth-observatory",
          "name": "Geoinformatics Research Group, Lamont-Doherty Earth Observatory"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
