      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:indian-subcontinent-temperature-field",
        "name": "indian-subcontinent-temperature-field"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-0865-0916",
          "name": "Siddharth Rout",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-british-columbia-2329-west-mall-vancouver-bc-v6t-1z4-can",
            "name": "University of British Columbia, 2329 West Mall, Vancouver, BC, V6T 1Z4, Canada"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The dataset is highly impactful because it provides a comprehensive, long-term view of surface temperature across a densely populated and climatically diverse region, enabling insights that would otherwise be difficult or impossible. Without this dataset, educators and researchers would have limited ability to train students or develop models that accurately capture regional climate dynamics, hindering capacity-building in climate science, data-driven meteorology, and disaster prediction. For communities, the absence of such high-resolution historical data would constrain early-warning systems and preparedness strategies for heatwaves, floods, or other temperature-related hazards, directly affecting human safety and resilience. From a planetary perspective, this dataset allows detailed study of geophysical and environmental phenomena such as regional warming trends, monsoon variability,…"
        }
      ]
    },
