          "name": "EcoHydro Lab, Department of Hydrology, Indian Institute of Technology Roorkee"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:zenodo",
        "name": "Zenodo"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Mangukiya, N. K., Kumar, K. B., Dey, P., Sharma, S., Bejagam, V., Mujumdar, P. P., & Sharma, A. (2025). CAMELS-IND: Hydrometeorological time series and catchment attributes for 228 catchments in Peninsular India. Earth System Science Data, 17(2), 461–491. https://doi.org/10.5194/essd-17-461-2025"
        }
