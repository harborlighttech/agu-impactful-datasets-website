      "agu:stableKey": "title:parma/expacs",
      "agu:nominatorCount": 1,
      "agu:citationCount": 4,
      "agu:reuseCount": 30,
      "description": "PARMA/EXPACS is a globally applicable dataset and calculator of atmospheric cosmic-ray particle spectra and radiation dose fields, available free of charge from Japan Atomic Energy Agency. Built on the PHITS-based Analytical Radiation Model in the Atmosphere (PARMA), EXPACS rapidly returns location-, altitude-, date- and solar-cycle-dependent fluxes of neutrons, protons, heavy ions (Z≤28), muons, electrons/positrons and photons, together with derived quantities such as effective dose, ambient dose equivalent, absorbed dose in air and ion-pair production rates. The underlying model has been extensively validated against measurements over a wide range of geomagnetic cutoffs, altitudes and solar conditions, and successive PARMA releases widened the physics coverage (e.g., zenith-angle dependence) and application domains. Because EXPACS is Excel-based with well-documented inputs/outputs, it lowers the barrier to reproducible analyses for researchers and practitioners across disciplines. The dataset underpins operational aviation dose assessment, public exposure evaluation, geoscience…",
      "url": "https://phits.jaea.go.jp/expacs/index.html",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:tatsuhiko-sato",
          "name": "Tatsuhiko Sato"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:japan-atomic-energy-agency",
        "name": "Japan Atomic Energy Agency"
      },
