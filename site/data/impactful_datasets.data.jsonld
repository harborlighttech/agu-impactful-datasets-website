      ],
      "name": "GLDAS Catchment Land Surface Model L4 daily 0.25 x 0.25 degree GRACE-DA1 V2.2",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0051",
      "agu:stableKey": "title:gldas catchment land surface model l4 daily 0.25 x 0.25 degree grace-da1 v2.2",
      "agu:nominatorCount": 1,
      "agu:citationCount": 2,
      "agu:reuseCount": 1,
      "description": "The Global Land Data Assimilation System (GLDAS) project estimates land surface states and fluxes with global coverage and high resolution (up to 0.25 degrees x 3 hourly). GLDAS data products have been generated using several meteorological forcing inputs (see LDAS website for details) and land surface models (LSMs), including the Variable Infiltration Capacity (VIC) model (Liang et al., 1994), the Noah model (Ek et al., 2003), and the Catchment Land Surface Model (CLSM; Koster et al., 2000). GLDAS outputs include water balance states and fluxes such as runoff, soil moisture, and snow water equivalent, as well as energy balance states and fluxes, e.g. land surface temperature and latent and sensible heat flux. GLDAS-2.2, the newest data collection released under the GLDAS umbrella, contributes a new and important piece of water budget information that most LSMs do a poor job estimating: groundwater storage. GLDAS-2.2 assimilates terrestrial water storage (TWS) from the Gravity Recovery and Climate Experiment (GRACE) and GRACE Follow-On (GRACE-FO) into CLSM to produce groundwater…",
      "url": "https://disc.gsfc.nasa.gov/datasets/GLDAS_CLSM025_DA1_D_2.2/summary?keywords=GLDAS%202.2",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:bailing-li-matthew-rodell-sujay-kumar-hiroko-kato-beaudoing-augusto-ge",
          "name": "Bailing Li, Matthew Rodell, Sujay Kumar, Hiroko Kato Beaudoing, Augusto Getirana, Benjamin F. Zaitchik, Luis Gustavo de Goncalves, Camila Cossetin, Soumendra Bhanja, Abhijit Mukherjee, Siyuan Tian, Natthachet Tangdamrongsub, Di Long, Jamiat Nanteza, Jejung Lee, Frederick Policelli, Ibrahim B. Goni, Djoret Daira, Mohammed Bila, Gabriëlle de Lannoy, David Mocko, Susan C. Steele-Dunne, Himanshu Save, Srinivas Bettadpur"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:andrew-fisher-and-ariana-l-mcdermott-ges-disc",
          "name": "Andrew Fisher and Ariana L. McDermott (GES DISC)"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:ges-disc",
        "name": "GES-DISC"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Li, B., et al. (2019). Global grace data assimilation for groundwater and drought monitoring: Advances and challenges. Water Resources Research, 55(9), 7564–7586. https://doi.org/10.1029/2018WR024618"
        },
        {
          "@type": "CreativeWork",
          "text": "Rodell, M., Houser, P. R., Jambor, U., Gottschalck, J., Mitchell, K., Meng, C.-J., Arsenault, K., Cosgrove, B., Radakovich, J., Bosilovich, M., Entin, J. K., Walker, J. P., Lohmann, D., & Toll, D. (2004). The global land data assimilation system. Bulletin of the American Meteorological Society,…"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Eldrett JS, Ma C, Bergman S, Ozkan A, Minisini D, Lutz B, Jackett S-J, Macaulay C, Kelly AE. 2015b. Origin of limestone–marlstone cycles: Astronomic forcing of organic-rich sedimentary rocks from the…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-7012-5472",
          "name": "Jacob Schaperow",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:nasa-goddard-earth-sciences-data-and-information-services-center-ges-d",
            "name": "NASA Goddard Earth Sciences Data and Information Services Center (GES DISC), NASA Goddard Space Flight Center, 8800 Greenbelt Rd, Greenbelt, MD 20771, USA"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "GLDAS uses land surface models (LSMs) to estimate hydrologic variables such as runoff, evaporation, and soil moisture. LSMs are complex models that integrate a plethora of data sources, including meteorological inputs from numerical weather prediction systems (which themselves integrate atmospheric measurements from satellites, ground-based radars, and weather balloons), and land characteristics such as vegetation cover, albedo, and soil properties. LSM frameworks like GLDAS are important because they provide estimates of variables that are otherwise difficult to observe, but which have profound implications for our society and our food supply. GLDAS runoff estimates, for example, enable hydrologists to make streamflow forecasts, which inform reservoir storage/release decisions, floodplain mapping, and drought monitoring. GLDAS-2.2, in particular, addresses a key challenge that other…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0052",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0052",
