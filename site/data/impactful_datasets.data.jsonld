      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0003-1895-5633",
          "name": "Alexandru Codilean",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:school-of-science-university-of-wollongong-northfields-avenue-wollongo",
            "name": "School of Science, University of Wollongong, Northfields Avenue, Wollongong, NSW 2522, Australia"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "OCTOPUS has set a new benchmark for Indigenous data governance in Australia by integrating both the FAIR (Findability, Accessibility, Interoperability, and Reusability) and CARE (Collective Benefit, Authority to Control, Responsibility, and Ethics) principles. As a globally registered data repository, OCTOPUS supports a broad international user community and has fulfilled over 3,500 individual data requests from researchers worldwide. The platform is widely employed in research, postgraduate training, and university teaching across multiple countries. Its extensive datasets have enabled global and regional geomorphological studies that were previously unattainable, providing a foundation for testing key hypotheses in Earth surface processes. Moreover, OCTOPUS has significantly advanced recent models of the initial peopling of the Australian continent."
        }
      ]
    },
