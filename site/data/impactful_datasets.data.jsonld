        },
        {
          "@type": "CreativeWork",
          "text": "Wang, J., Yu, G., Han, L., Zhang, J., Sun, M., Krause, S., & Liu, C. (2025). Unveiling distribution and drivers of soil organic carbon in coastal China: Salt marshes and tidal flats as major carbon…"
        },
