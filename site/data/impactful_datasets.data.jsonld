      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Elipot S., R. Lumpkin, R. C. Perez, J. M. Lilly, J. J. Early, and A. M. Sykulski (2016), A global surface drifter dataset at hourly resolution, J. Geophys. Res.-Oceans, 121, doi:10.1002/2016JC011716."
