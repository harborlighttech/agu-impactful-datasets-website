      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "Research cores from the Eagle Ford Group and bounding formations were made available for collaborative research across numerous international academic, government and industry institutions. The dataset has substantial educational and outreach impact. The research supported five student internships, twelve doctorates, three post-doctorates and several early career scientists, leading to over 25 publications and the successful employment of numerous researchers in Earth Sciences. The dataset is currently being utilized and added to by a new cohort of enthusiastic earth Science students and researchers. The dataset has a positive impact on physical systems, including improved understanding of local, regional and global paleoenvironmental processes that influence climate and marine conditions during Greenhouse periods of high atmospheric carbon dioxide and temperatures. One of the two…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0030",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0030",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0030"
        },
        {
          "@type": "PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.1594/PANGAEA.917503"
        }
      ],
      "name": "Cenozoic Global Reference benthic foraminifer carbon and oxygen Isotope Dataset (CENOGRID)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0030",
      "agu:stableKey": "doi:10.1594/pangaea.917503|cenozoic global reference benthic foraminifer carbon and oxygen isotope dataset (cenogrid)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 6,
      "description": "Much of the scientific community’s understanding of Earth’s past climate states comes from measurements of oxygen and carbon isotope variations in deep-sea benthic foraminifera. Yet, major intervals in those records that lack the temporal resolution and/or age control required to identify climate forcing and feedback mechanisms. Here, 66 million years of global climate are documented using a new high-fidelity Cenozoic global reference dataset of benthic carbon and oxygen isotopes (CENOGRID). Using recurrence analysis, Earth’s climate on million-year timescales can be grouped into Hothouse, Warmhouse, Coolhouse, and Icehouse states, separated by transitions related to changing greenhouse gas levels and the growth of polar ice sheets. Each Cenozoic climate state is paced by orbital cycles, but the response to radiative forcing is state dependent.",
      "url": "https://doi.org/10.1594/PANGAEA.917503",
      "sameAs": [
        "https://doi.pangaea.de/10.1594/PANGAEA.917503"
      ],
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:thomas-westerhold-norbert-marwan-anna-joy-drury-diederik-liebrand-clau",
          "name": "Thomas Westerhold, Norbert Marwan, Anna Joy Drury, Diederik Liebrand, Claudia Agnini, Eleni Anagnostou, James S. K. Barnet, Steven M. Bohaty, David De Vleeschouwer, Fabio Florindo, Thomas Frederichs, David A. Hodell, Ann E. Holbourn, Dick Kroon, Vittoria Lauretano, Kate Littler, Lucas J. Lourens, Mitchell Lyle, Heiko Pälike, Ursula Röhl, Jun Tian, Roy H. Wilkens, Paul A. Wilson, James C. Zachos"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:world-data-center-pangaea",
        "name": "World Data Center PANGAEA"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Westerhold, T., et al. (2020). An astronomically dated record of Earth’s climate and its predictability over the last 66 million years. Science, 369(6509), 1383–1387. https://doi.org/10.1126/science.aba6853"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "3 examples – there are many more"
        },
        {
          "@type": "CreativeWork",
          "text": "1) Comparing Global mean surface temperature (GMST) to CO2 reconstructions https://paleo-co2.org The CenCO2PIP Consortium. (2023). Towards a Cenozoic History of Atmospheric CO2, Science, 382(6675),…"
        },
