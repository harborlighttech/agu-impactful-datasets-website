      "agu:reuseCount": 0,
      "description": "The conPhs data product contains GNSS radio occultation measurements that have been corrected for instrumental and environmental effects.",
      "url": "https://data.cosmic.ucar.edu/gnss-ro/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:ucar",
