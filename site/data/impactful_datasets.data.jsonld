      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Roult G., Montagner J.P., Stutzmann E., Barbier S., Guiveneux G., The Geoscope program: Its data center, Phys. Earth Planet. Int., 113, 25-43, 1999. https://doi.org/10.1016/S0031-9201(99)00024-2"
        },
        {
          "@type": "CreativeWork",
          "text": "Leroy N., Vallée, M., Zigone D. et al., GEOSCOPE network: 40 Yr of global broadband seismic data, Seismol. Res. Lett., 95, 1495–1517, 2024. https://doi.org/10.1785/0220230176"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Geoscope data have been widely used (more than 1700 publications since 1982) in a lot of seismological fields, in particular for deep Earth and earthquake studies."
        },
        {
          "@type": "CreativeWork",
          "text": "The list of publications (years 2004-2023) using GEOSCOPE data is available on : http://geoscope.ipgp.fr/index.php/en/observatory/area-of-documentation/list-of-publications-based-on geoscope-data"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-9958-3012",
          "name": "Jean-Paul Montagner",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:universit-paris-cit-institut-de-physique-du-globe-de-paris-1-rue-jussi",
            "name": "Université Paris Cité, Institut de Physique du Globe de Paris,\n1 rue Jussieu, 75238 Paris, France"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The GEOSCOPE network was the first global seismic network in the 1980s to make its dataset available to the worldwide seismological community. Since then, thanks to the Federation of Digal Seismograph Network (FDSN), a standardized format of archival was defined, seismic data are stored, shared and distributed openly. This policy of free and open data sharing on a global scale has also been adopted in other scientific fields. This international cooperation has made it possible to obtain the best possible global coverage of broadband seismic stations,—something that no single country could have accomplished on its own. GEOSCOPE stations rank among the world’s lowest-noise seismic stations. Their data are widely used on a routine basis for structural and earthquake investigations . More generally, the GEOSCOPE dataset contributes to the monitoring and mitigation of seismic, volcanic, and…"
        }
      ]
    },
    {
      "@type": "Dataset",
