        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Lei, Y., Gardner, A. S., & Agram, P. (2022). Processing methodology for the ITS_LIVE Sentinel-1 ice velocity products. Earth System Science Data, 14(11), 5111–5137.…"
        },
        {
          "@type": "CreativeWork",
