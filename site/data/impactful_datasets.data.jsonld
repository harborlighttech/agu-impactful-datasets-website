      "agu:datasetId": "agu-0099",
      "agu:stableKey": "title:openaq",
      "agu:nominatorCount": 1,
      "agu:citationCount": 6,
      "agu:reuseCount": 0,
      "description": "OpenAQ is the world's largest open-source, open-access platform for harmonized, ground-level ambient air quality data. Its mission is to combat air inequality by making air quality data universally accessible for science, policy, and public empowerment. The platform aggregates and processes real-time and historical measurements from government reference monitors, research institutions, community organizations, and low-cost air sensors worldwide. - https://openaq.org/developers/platform-overview/",
      "url": "https://openaq.org/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:openaq",
          "name": "OpenAQ"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:dr-colleen-rosales-chris-hagerbaumer-russ-biggs",
          "name": "Dr. Colleen Rosales, Chris Hagerbaumer, Russ Biggs"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:explore-openaq-org-api-openaq-org",
        "name": "explore.openaq.org, api.openaq.org"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Here are some of the publications that have used OpenAQ datasets:"
        },
        {
          "@type": "CreativeWork",
          "text": "1. Pramanik, P., Last, C., et al. “Utilizing Remote Sensing and Machine Learning to Analyze Air Pollution Exposure.” AGU Fall Meeting 2024, Washington DC."
        },
        {
          "@type": "CreativeWork",
          "text": "2. Pramanik, P., Last, C. “Remote Sensing and Machine Learning Models for Air Pollution Exposure.” AGU Fall Meeting 2023, San Francisco."
        },
        {
          "@type": "CreativeWork",
          "text": "3. Last, C., Pramanik, P., et al. “Using Open Data to Understand Air Pollution Exposure.” AGU Fall Meeting 2022, Chicago."
        },
        {
          "@type": "CreativeWork",
          "text": "4. Last, C., Pramanik, P., et al. “Towards an Open Global Air Quality Monitoring Platform to Assess Children’s Exposure to Air Pollutants in the Light of COVID-19 Lockdowns.” SIG CHI 2021, Yokohama."
        },
        {
          "@type": "CreativeWork",
          "text": "5. AQAI's openaq-engine, https://github.com/AQ-AI/openaq-engine"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-5656-6340",
          "name": "Prithviraj Pramanik",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:department-of-computer-science-and-engineering-national-institute-of-t",
            "name": "Department of Computer Science and Engineering\nNational Institute of Technology Durgapur, MG Avenue, West Bengal 713209, India"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The OpenAQ dataset has become the de facto open standard for global air quality data, serving as an indispensable backbone for equitable environmental research and policy action. Through its transparent aggregation of regulatory, low-cost, and citizen-sensing data, OpenAQ bridges critical information gaps in the Global South, where access to reliable environmental data is often the first barrier to action. AQAI has built our open-source OpenAQ-Engine (https://github.com/AQ-AI/openaq-engine ) atop this foundation, extending it with UNICEF-backed pilots in Laos, Mongolia, and Belize to model children’s exposure to air pollution and design early-warning tools for health systems. The dataset’s harmonised schema and public API enable cross-country integration with satellite and meteorological layers, creating the first hyperlocal “air-health” intelligence framework now informing both…"
        }
      ]
    },
