      ],
      "name": "The National Geologic Map Database (NGMDB)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:interior"
      },
      "agu:datasetId": "agu-0117",
      "agu:stableKey": "title:the national geologic map database (ngmdb)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "The National Geologic Map Database (NGMDB), maintained by the U.S. Geological Survey (USGS) in partnership with the Association of American State Geologists, is the nation’s “go to” central repository and gateway for geoscience map data at all scales. Established by the Geologic Mapping Act of 1992, the NGMDB integrates more than a century of geologic mapping into a dynamic, searchable, and accessible digital platform. It contains tens of thousands of geologic maps and related spatial datasets produced by federal, state, and academic institutions, spanning content such as bedrock and surficial geology, critical materials and energy resources, geologic hazards, hydrogeology, and environmental geology. Designed for both specialists and the public, the NGMDB provides vetted data critical for research, education, land-use planning, resource management, and hazard mitigation. By unifying legacy paper maps with modern GIS-ready data, the database not only preserves the scientific heritage of U.S. geology but also enables new applications across disciplines. Its open access ensures that…",
      "url": "https://ngmdb.usgs.gov/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:david-soller-senior-program-scientist-for-the-national-geologic-map-da",
          "name": "David Soller, Senior Program Scientist for the National Geologic Map Database,"
        },
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:national-cooperative-geologic-mapping-program",
          "name": "National Cooperative Geologic Mapping Program"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:u-s-geological-survey-usgs-in-partnership-with-the-association-of-amer",
          "name": "U.S. Geological Survey (USGS) in partnership with the Association of American State Geologists"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:u-s-geological-survey-usgs-via-usgs-data-catalog",
        "name": "U.S. Geological Survey (USGS) via USGS Data Catalog"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Reference Publication: Soller, D. R., Wardwell, R. S., Garrity, C. P., & Stamm, N. R. (2025). The USGS national geologic map database—Resource for geoscience professionals and the public. Geotechnical Frontiers 2025, 252–259. https://doi.org/10.1061/9780784485989.026"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Lee, C.-T. A., Jiang, H., Ronay, E., Minisini, D., Stiles, J., & Neal, M. (2018). Volcanic ash as a driver of enhanced organic carbon burial in the Cretaceous. Scientific Reports, 8(1), 4197.…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-3032-1046",
          "name": "Nominator 1a:\nMartha Cary (Missy) Eppes\n\nNominator 1b:\nAnne Tillery\n\nNominator 1c:\nMike Timmons\n\nNominator 1d: \nNelia W. Dunbar\n\nNominator 1e:\nGlen Thackray",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:nominator-1a-professor-of-earth-sciences-university-of-north-carolina",
            "name": "Nominator 1a:\nProfessor of Earth Sciences, University of North Carolina at Charlotte, 9201 University City Blvd, Charlotte, NC 28223"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "There is no more important resource to any individual wishing to interact with – or understand – Earth than a geologic map with its underlying topographic basemaps. The NGMDB is the nation’s single most comprehensive archive for this essential knowledge – accessible in a distribution system that is now georeferenced for use with any other map in the US. With it, anyone can tap into over a century of accumulated ‘boots-on-the-ground’ geologic mapping that represents decades of hours of field observations, interpretation and compilation, typically supported by some combination of microscopy, geochemistry, and geochronology. When we employ these maps, we are assured that somewhere, sometime, a geoscientist has literally laid hands on - or even sometimes famously tasted - the soil, sediment, or rock that the map depicts. This is somehow very assuring, knowing that geologists explored and…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0118",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0118",
      "identifier": [
