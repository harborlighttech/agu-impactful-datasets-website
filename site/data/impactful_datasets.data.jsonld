      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The CEMs offer an integrated, curated overview of many aspects of California that are useful for assessing earthquake hazards. It is composed of several models, each developed by different community members and available in separate repositories, giving the broader community access to a wide range of information relevant for addressing several of the UN’s sustainability goals. The Community Fault Model (CFM) provides a detail and dataset of fault surfaces, constantly updated based on community feedback, aiding in the evaluation of earthquake rupture likelihood—a “people dimension” goal. The Community Velocity Model (CVM) compiles seismic velocity models across various scales and covering different regions centered on the San Andreas Fault System, helping to better understand the region’s subsurface structure and, importantly, to simulate ground-shaking intensity during future…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0035",
