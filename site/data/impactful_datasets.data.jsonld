          "name": "Jeff Sevadjian"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:po-daac",
        "name": "PO.DAAC"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Wang, J., Lucas, A. J., Stalin, S., Lankhorst, M., Send, U., Schofield, O., Kachelein, L., Haines, B., Meinig, C., Pinkel, R., Farrar, J. T., & Fu, L. (2025). Swot mission validation of sea surface height measurements at sub‐100 km scales. Geophysical Research Letters, 52(11), e2025GL114936.…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-4166-4044",
          "name": "Matthias Lankhorst",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:scripps-institution-of-oceanography-ucsd-8622-kennel-way-la-jolla-ca-9",
            "name": "Scripps Institution of Oceanography, UCSD, 8622 Kennel Way, La Jolla, CA 92037"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset is a wonderful example of a multi-purpose, multi-institutional effort that combines one very specific goal (here: to validate data from a new satellite) with enabling new science. The data show detail-rich features of ocean circulation, internal waves, and mesoscale variability, and will take years to fully exploit. Combining this in-situ dataset with the data from the satellite that it helped validate, exciting new insights into ocean variability from large scales to the sub-mesoscale may be expected. For the nominator, it was a very rewarding experience to design, collect, and process the data, and to see the results on the satellite and new science trickling in."
        }
      ]
    },
