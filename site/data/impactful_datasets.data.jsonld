      "name": "Indian Subcontinent 2m Temperature Field",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:atmos"
      },
      "agu:datasetId": "agu-0077",
      "agu:stableKey": "title:indian subcontinent 2m temperature field",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "Temperature at 2m above surface level in Kelvin from 1985-01-01 to 2024-12-31 recorded every 3 hours. Sourced from ERA5 ECMWF reanalysis. Pixel resolution is 257 x 257 and meridional resolution is 0.25 degree. Latitude domain [10° South , 54° North], Longitude domain [50° East, 114° East].",
      "url": "https://www.kaggle.com/datasets/siddharthrout/indian-subcontinent-temperature-field",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:siddharth-rout",
          "name": "Siddharth Rout"
