        }
      ],
      "name": "Atmospheric Infrared Sounder (AIRS)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:atmos"
      },
      "agu:datasetId": "agu-0020",
      "agu:stableKey": "title:atmospheric infrared sounder (airs)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 0,
      "agu:reuseCount": 0,
      "description": "AIRS is a hyperspectral infrared sounder on the NASA Aqua spacecraft covering the 3.7-15.4 μm infrared spectral region with 2378 channels and spatial resolution of 13.5 km at nadir. AIRS was launched into a 705 km altitude orbit on May 4, 2002, and has been in routine data gathering mode essentially uninterrupted since September 2002. The 1:30 PM ascending node and orbital altitude of the Aqua spacecraft orbit have been accurately maintained (until 2022) and daily (nearly) global coverage is essentially achieved from the ascending and descending orbits. The AIRS infrared radiances are operationally assimilated in all major global weather prediction systems. These radiances are also routinely used to retrieve vertical profiles of atmospheric temperature, water vapor, and key atmospheric constituents as well as cloud and surface parameters. The AIRS long record (since 2002) spans most of the 21st Century (until now) and the AIRS instrument is remarkably stable: with potential instrument drifts in time that are at least one order of magnitude smaller than the physical climate change…",
      "url": "https://airs.jpl.nasa.gov/data/get-data/standard-data/",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:airs-science-team",
          "name": "AIRS Science Team"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:nasa-ges-disc",
        "name": "NASA GES DISC"
      },
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-5281-9478",
          "name": "Joao Teixeira",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:jet-propulsion-laboratory-caltech-4800-oak-grove-drive-pasadena-ca-911",
            "name": "Jet Propulsion Laboratory, Caltech, 4800 Oak Grove Drive, Pasadena, CA 91109"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The infrared radiances measured by AIRS are used (as part of data assimilation or retrieval systems) to create three-dimensional depictions of atmospheric temperature and water vapor, as well as to provide a wealth of information on other gases and cloud properties. With 2378 spectral channels, AIRS has a spectral resolution more than 100 times greater than previous infrared sounders and provides more accurate information on the vertical profiles of atmospheric temperature and water vapor. A major advantage of the AIRS instrument as compared to weather balloons (the traditional way of providing temperature and water vapor profile observations for weather prediction models) is its global coverage because of its view from space. The coverage obtained from the launch of weather balloons over much of the Earth’s land masses and most of the oceans and ice surfaces is extremely small. In…"
        }
      ]
    },
