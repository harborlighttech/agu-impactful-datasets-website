    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0076",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0076",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0076"
        }
      ],
      "name": "Indian Landslide Susceptibility Map (ILSM)",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:surface"
      },
      "agu:datasetId": "agu-0076",
      "agu:stableKey": "title:indian landslide susceptibility map (ilsm)",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 11,
      "description": "Every year landslides claim many lives and cause losses amounting to billions of dollars. Understanding the areas prone to landslides and the factors driving them is critical to reducing the impact of landslides. The framework we have developed relies on machine learning models for their flexibility with big datasets and ease of mapping with higher resolution. ILSM utilizes datasets obtained from satellites and remote sensing devices, to provide a high-resolution map of landslide zones in India. It also ensemble probabilistic estimates for landslide susceptibility which can help develop landslide models. This model accurately detects and locates landslide-prone zones that are previously mapped and also identifies new landslide zones. Therefore, it can serve as a useful tool for landslide monitoring and awareness programs.",
      "url": "https://hydrosense.users.earthengine.app/view/ilsm",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:nirdesh-sharma-manabendra-saharia-g-v-ramana",
          "name": "Nirdesh Sharma, Manabendra Saharia, G.V. Ramana"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:zenodo",
        "name": "Zenodo"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Sharma, N., Saharia, M., & Ramana, G.V. (2024). High resolution landslide susceptibility mapping using ensemble machine learning and geospatial big data. Catena, 235, 107653. https://doi.org/10.1016/j.catena.2023.107653"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "ILSM has been cited in the Parliament of India citing landslides need better management. (https://eparlib.sansad.in/bitstream/123456789/2981313/1/569.pdf )"
        },
        {
          "@type": "CreativeWork",
          "text": "ILSM has been cited over 75 times in 18 months since it has been…"
        },
        {
          "@type": "CreativeWork",
          "text": "ILSM has been used to develop landslide vulnerability and hazard maps that have been published. (https://doi.org/10.1007/s11069-025-07256-6 )"
        },
        {
          "@type": "CreativeWork",
          "text": "ILSM has been reused as a baseline hazard layer for developing slope stability and rainfall-triggered landslide early warning models."
        },
        {
          "@type": "CreativeWork",
          "text": "ILSM has been shown in many news articles and blogs"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-5275-0821",
          "name": "Dr. Manabendra Saharia",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:indian-institute-of-technology-delhi-hauz-khas-new-delhi-110016-india",
            "name": "Indian Institute of Technology Delhi, Hauz Khas, New Delhi-110016, India"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The Indian Landslide Susceptibility Map (ILSM) is the first high-resolution, machine learning–based national-scale landslide susceptibility map of India, developed at ~100 m resolution. In my opinion, this dataset is transformative because it combines multiple geophysical, hydrological, meteorological, and anthropogenic factors into a reproducible, data-driven framework. It addresses long-standing limitations of heuristic or coarse-scale maps that often could not capture localized landslide hazards. ILSM was based on the idea that in developing countries state boundaries play an important role since inventory mapping and all such mapping initiatives are taken by states. However geographical and geological conditions don’t vary largely in neighbouring states. So using big data we can learn landslide susceptibility in data poor regions. Without the ILSM, disaster risk reduction in India…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0077",
