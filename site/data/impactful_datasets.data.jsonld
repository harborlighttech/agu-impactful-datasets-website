      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-3924-0277",
          "name": "Nicholas Kruskamp",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:rti-international-3040-cornwallis-road-research-triangle-park-nc-27709",
            "name": "RTI International, 3040 Cornwallis Road, Research Triangle Park, NC 27709"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "This dataset provides the latest updates to the previously released gridded methane emissions estimates consistent with national U.S. UNFCCC reporting, now covering the years 2012 - 2022. Compared to previous gridded methane data products, this update more closely aligns the activity and location data used in gridding with the data used in U.S. Environmental Protection Agency (EPA) national inventory estimates and includes 9 new sources - 5 of them in Land Use, Land-Use Change, and Forestry sources. This update now covers 99.99% of anthropogenic methane emissions captured in the inventory. Emissions in this dataset rely on and are consistent with time series of source-specific anthropogenic GHG emissions that are reported annually in the Inventory of U.S. Greenhouse Gas Emissions and Sinks (GHGI), produced by the EPA. Bottom-up spatial disaggregation of methane inventory estimates, such…"
        }
      ]
    },
