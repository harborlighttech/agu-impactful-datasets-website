          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:joe-kennedy-maria-liukis-luis-l-pez",
          "name": "Joe Kennedy, Maria Liukis, Luis Lòpez"
        }
      ],
      "includedInDataCatalog": {
