    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0047",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0047",
      "identifier": [
        {
          "@type": "PropertyValue",
