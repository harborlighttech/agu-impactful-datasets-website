      ],
      "name": "ChemLotUS: A Benchmark Data Set of Lotic Chemistry Across US River Networks",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:ocean"
      },
      "agu:datasetId": "agu-0031",
      "agu:stableKey": "doi:10.1029/2024wr039355|chemlotus: a benchmark data set of lotic chemistry across us river networks",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 1,
      "description": "Curated water chemistry dataset for US rivers containing 35,000,000 records from 290,000 locations, additionally joined to high-resolution national hydrography. The join enables connections with multiple earth system features. Currently, it includes 11 analytes representing geogenic, biogenic, and anthropogenic processes: calcium, conductivity, pH, total suspended solids, turbidity, dissolved oxygen, total organic carbon, chlorophyll a, nitrate, soluble reactive phosphorus, and total phosphorus. All records were comprehensively curated, most notably by removing duplicated observations, converting units, and aggregating strongly correlated chemical forms. 95% of monitored river reaches were linked to three or fewer monitoring sites, with sample patterns revealing a strong measurement bias to high order streams. ChemLotUS enables new opportunities for investigations of continental scale variation in and controls on water quality, so far exemplified by diurnal variations of dissolved oxygen, pH in headwaters compared to their corresponding river mouths, and total suspended solids as a…",
      "url": "https://doi.org/10.1029/2024WR039355",
      "creator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:nicolas-fernandez-matthew-j-cohen-james-w-jawitz",
          "name": "Nicolas Fernandez, Matthew J. Cohen, James W. Jawitz"
        }
      ],
      "agu:curator": [
        {
          "@type": "Person",
          "@id": "urn:org:agu:data:impactful-datasets:id:person:cuahsi",
          "name": "CUAHSI"
        }
      ],
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "@id": "urn:org:agu:data:impactful-datasets:id:organization:hydroshare",
        "name": "Hydroshare"
      },
      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Fernandez, N., Cohen, M. J., & Jawitz, J. W. (2025). Chemlotus: A benchmark data set of lotic chemistry across us river networks. Water Resources Research, 61(5), e2024WR039355. https://doi.org/10.1029/2024WR039355"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Published in May 2025, this dataset has been downloaded more than 600 times and cited by 7 peer reviewed publications in its first year. The dataset has also triggered the collaboration of nearly 20…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0001-7979-2941",
          "name": "Nicolas Fernandez",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:university-of-florida-water-institute-570-weil-hall-gainesville-fl-326",
            "name": "University of Florida, Water Institute, 570 Weil Hall, Gainesville, FL 32611"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "Having large amounts of water quality information (35 million records of 11 water constituents, covering 290,000 locations in continental scale) linked to their specific position in river networks facilitates new discoveries, cross disciplinary collaborations, and education. For instance, if the concentration of water constituents and the characteristics of the rivers where the measurements occur are known simultaneously, as enabled by this dataset, it becomes possible to determine which of these characteristics exert the greatest influence on riverine water chemistry. Further, noting that multiple sciences use the same river networks to assign their observations, such as ecology, demographics and econometrics, it is now possible to investigate how water chemistry responds to multiple systems. In view of these new connections, education on riverine water resources can now take a more…"
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0032",
