    {
      "@type": "Dataset",
      "@id": "urn:org:agu:data:impactful-datasets:id:dataset:agu-0012",
      "mainEntityOfPage": "https://impactfuldatasets.agu.org/#/dataset/agu-0012",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "AGU-Impactful-Datasets-ID",
          "value": "agu-0012"
        }
      ],
      "name": "A global open-source dataset of monthly irrigated and rainfed cropped areas (MIRCA-OS) for the 21st century",
      "alternateName": "",
      "keywords": {
        "@id": "urn:org:agu:data:impactful-datasets:id:theme:biosphere"
      },
      "agu:datasetId": "agu-0012",
      "agu:stableKey": "title:a global open-source dataset of monthly irrigated and rainfed cropped areas (mirca-os) for the 21st century",
      "agu:nominatorCount": 1,
      "agu:citationCount": 1,
      "agu:reuseCount": 7,
      "description": "The Monthly Irrigated and Rainfed Cropped Area Open-Source (MIRCA-OS) dataset provides global gridded (5-arcminute, ~10 km) maps of irrigated and rainfed harvested areas for 23 crop classes from 2000 to 2015. Built from municipal- to national-scale statistics, updated crop calendars, and global land cover products, MIRCA-OS delivers monthly and annual representations of growing areas, maximum cropped areas, and crop calendars for both irrigated and rainfed systems. It integrates diverse international and national sources (e.g., FAOSTAT, AQUASTAT, EUROSTAT) with an improved downscaling methodology to allocate harvested areas spatially. Products are available in GeoTIFF, NetCDF, and CSV formats, along with input data sources and code, in line with FAIR principles. Supporting applications in agriculture, water resources, climate impact studies, and sustainable development, MIRCA-OS enables detailed insights into global cropland change since 2000 and provides a robust foundation for assessments of land use, food security, and sustainability.",
      "url": "https://www.hydroshare.org/resource/60a890eb841c460192c03bb590687145/",
