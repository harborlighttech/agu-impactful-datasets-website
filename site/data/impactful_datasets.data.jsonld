      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "This foundational dataset, resulting from a comprehensive survey of China's coastal blue carbon ecosystems, has served as a cornerstone for several subsequent high-impact studies. The extensive…"
