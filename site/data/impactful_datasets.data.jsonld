        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Influence of orography in the spatial variability of rainfall extremes - Mazzoglio et al. (2023). A local regression approach to analyze the orographic effect on the spatial variability of sub-daily…"
