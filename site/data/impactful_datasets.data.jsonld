      "citation": [
        {
          "@type": "CreativeWork",
          "text": "Lin, C., Lin, C. C., Liu, J., Rajesh, P. K., Matsuo, T., Chou, M., Tsai, H., & Yeh, W. (2020). The early results and validation of formosat‐7/cosmic‐2 space weather products: Global ionospheric specification and ne‐aided abel electron density profile. Journal of Geophysical Research: Space Physics,…"
        }
      ],
      "agu:reuseExample": [
        {
          "@type": "CreativeWork",
          "text": "Daniell, R. E., Eastes, R. W., Martinis, C. R., & Karan, D. K. (2025). Equatorial ionization anomaly x‐pattern occurrences observed by the gold mission during its first 5 years. Journal of…"
        }
      ],
      "agu:nominator": [
        {
          "@type": "Person",
          "@id": "https://orcid.org/0000-0002-9271-7986",
          "name": "Robert E. Daniell, Jr",
          "affiliation": {
            "@type": "Organization",
            "@id": "urn:org:agu:data:impactful-datasets:id:organization:ionospheric-physics-consulting-38-sandy-ridge-rd-stoughton-ma-02072",
            "name": "Ionospheric Physics Consulting, 38 Sandy Ridge Rd, Stoughton, MA 02072"
          },
          "agu:sequence": 1
        }
      ],
      "agu:justification": [
        {
          "@type": "CreativeWork",
          "agu:sequence": 1,
          "text": "The truly global nature of the dataset makes it useful (essential) for the study of global aspects of the ionosphere including global correlations. The nominator knows of no other data set that is not confined to specific regions (e.g., continental regions) or specific times (e.g., nighttime). While the spatial and time resolution is too low for some studies, the global 3-D nature of the dataset makes it an incomparable resource for many ionospheric studies."
        }
      ]
